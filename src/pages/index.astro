---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import CommonReasons from '../components/CommonReasons.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Bass Coast Podiatry in Wonthaggi has provided podiatry care since 2007. Open Monday to Friday. Call (03) 5672 2309.">
	<section class="hero">
		<Glows set="hero" />
		<div class="container container--wide hero__grid above-glow">
			<div class="hero__panel zoom-frame">
				<Image
					class="hero__photo"
					src={heroImage}
					alt="Footprints in the sand along the water's edge at a beach."
					widths={[640, 1000, 1400, 1698]}
					sizes="(min-width: 64rem) 62vw, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="hero__plate glass">
					<h1 class="reveal-lines">Podiatry care in Wonthaggi since 2007</h1>
					<div class="btn-row">
						<a class="btn btn--icon" href={clinic.phoneHref} data-hero-call>
							<Icon name="phone" />
							Call {clinic.phone}
						</a>
						<a class="btn btn--outline" href={url('/our-services/')}>Our services</a>
					</div>
				</div>
			</div>

			<div class="hero__side">
				<article class="hero-card glass" aria-labelledby="visit-card-title">
					<a class="hero-card__corner" href={url('/contact/')}>
						<Icon name="arrowUpRight" size={20} />
						<span class="visually-hidden">Contact page</span>
					</a>
					<h2 id="visit-card-title">Visit us</h2>
					<div class="hero-card__body">
						<p class="hero-card__strong" data-today>{clinic.hours[0].days}, {clinic.hours[0].time}</p>
						<p class="hero-card__small" data-today-note>{clinic.hoursNote}</p>
						<p class="hero-card__address">
							{clinic.street}<br />
							{clinic.suburb}
						</p>
					</div>
					<p class="hero-card__links">
						<a class="text-link" href={clinic.directions} rel="noopener">Get directions <Icon name="arrow" size={18} /></a>
						<a href={url('/contact/#message')} data-contact>Send us a message</a>
					</p>
				</article>

				<article class="hero-card hero-card--claims glass" aria-labelledby="claims-card-title">
					<span class="hero-card__corner" aria-hidden="true"><Icon name="arrowUpRight" size={20} /></span>
					<h2 id="claims-card-title">Claims and rebates</h2>
					<p class="hero-card__body">
						<a class="hero-card__stretch" href={url('/claims-rebates/')}>Medicare, DVA, HICAPS, TAC and WorkSafe</a>
					</p>
				</article>
			</div>
		</div>
	</section>

	<CommonReasons />

	<section class="section services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal-lines">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="soft" />
		<div class="container container--wide team__inner above-glow">
			<div class="zoom-frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal-lines">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this team list still current?</span></p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal-lines">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal-lines">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="soft" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal-lines">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Today's hours in the Visit us card, worked out in Wonthaggi's time zone.
	import { clinic } from '../data/site';

	function showToday() {
		const el = document.querySelector('[data-today]');
		if (!el) return;
		const day = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short' }).format(new Date());
		const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
		const open = (clinic.openDays as readonly number[]).includes(index);
		el.textContent = open ? `Open today, ${clinic.openTime} to ${clinic.closeTime}` : 'Closed today';
		const note = document.querySelector('[data-today-note]');
		if (note && !open) note.textContent = `Open ${clinic.hours[0].days}, ${clinic.hours[0].time}.`;
	}

	document.addEventListener('astro:page-load', showToday);
</script>

<style>
	/* Hero: the beach photo fills the screen width, with an Ocean blue glass veil deepest on the left */

	/* Hero: a large rounded photo panel on the left and two frosted glass cards on the right,
	   over bright glows. Sized so the top of the cards below shows at 1440 x 900. */

	.hero {
		position: relative;
		padding-top: clamp(0.75rem, 2.5vh, 1.75rem);
	}

	.hero__grid {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@media (min-width: 64rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
		}
	}

	.hero__panel {
		position: relative;
		min-height: 34rem;
		border-radius: var(--bcp-radius-panel);
		box-shadow: var(--shadow-lift);
	}

	@media (min-width: 64rem) {
		.hero__panel {
			min-height: 0;
			height: clamp(26rem, calc(100svh - 17rem), 42rem);
		}
	}

	.hero__photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% 40%;
	}

	/* The headline sits on a frosted plate in the bottom left corner, so it keeps strong contrast */
	.hero__plate {
		position: absolute;
		left: clamp(0.75rem, 1.5vw, 1.5rem);
		right: clamp(0.75rem, 1.5vw, 1.5rem);
		bottom: clamp(0.75rem, 1.5vw, 1.5rem);
		width: fit-content;
		max-width: calc(100% - 2 * clamp(0.75rem, 1.5vw, 1.5rem));
		padding: clamp(1.25rem, 2.2vw, 2.25rem);
		border-radius: calc(var(--bcp-radius-panel) - 4px);
	}

	.hero__plate.glass {
		background: color-mix(in srgb, var(--bcp-white) 74%, transparent);
	}

	.hero h1 {
		max-width: 12.5ch;
		padding-bottom: 0.06em; /* room for descenders at the tight line height */
		margin-bottom: clamp(1rem, 2.2vh, 1.75rem);
		font-size: clamp(2.25rem, min(1.2rem + 4.5vw, 9vh), 5.4rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
	}

	/* Two glass cards, tinted by the glows behind them */
	.hero__side {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@media (min-width: 64rem) {
		.hero__side {
			grid-template-rows: 1.45fr 1fr;
		}
	}

	.hero-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: clamp(1.25rem, 1.8vw, 1.85rem);
		border-radius: var(--bcp-radius-panel);
	}

	.hero-card.glass {
		background: color-mix(in srgb, var(--bcp-white) 58%, transparent);
		border: 1px solid color-mix(in srgb, var(--bcp-white) 70%, transparent);
	}

	.hero-card h2 {
		margin: 0 0 0.25rem;
		padding-right: 3.5rem;
		font-size: clamp(1.375rem, 1.1rem + 0.6vw, 1.75rem);
	}

	.hero-card__corner {
		position: absolute;
		top: clamp(1rem, 1.5vw, 1.4rem);
		right: clamp(1rem, 1.5vw, 1.4rem);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid color-mix(in srgb, var(--bcp-blue) 40%, transparent);
		border-radius: 50%;
		color: var(--bcp-blue);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	a.hero-card__corner:hover,
	.hero-card--claims:hover .hero-card__corner {
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	.hero-card__body {
		flex: 1;
		margin: 0;
	}

	.hero-card__body p {
		margin: 0;
	}

	.hero-card__strong {
		color: var(--bcp-blue);
		font-size: 1.25rem;
		font-weight: var(--bcp-weight-heading);
	}

	.hero-card__small {
		color: var(--bcp-ink);
		line-height: 1.5;
	}

	.hero-card__address {
		margin-top: 0.75rem !important;
		line-height: 1.5;
	}

	.hero-card__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		margin: 0;
	}

	.hero-card__links a {
		font-weight: var(--bcp-weight-heading);
	}

	/* The whole Claims card is clickable through its link */
	.hero-card__stretch {
		color: var(--bcp-ink);
		font-size: 1.125rem;
		text-decoration: none;
	}

	.hero-card__stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--bcp-radius-panel);
	}

	.hero-card__stretch:focus-visible {
		outline: none;
	}

	.hero-card__stretch:focus-visible::after {
		outline: 3px solid var(--bcp-blue);
		outline-offset: 3px;
	}

	.hero-card--claims:hover .hero-card__stretch {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.team__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
