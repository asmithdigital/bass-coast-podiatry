---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import QuickActions from '../components/QuickActions.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Bass Coast Podiatry in Wonthaggi has provided podiatry care since 2007. Open Monday to Friday. Call (03) 5672 2309.">
	<section class="hero on-blue">
		<Image
			class="hero__bg"
			src={heroImage}
			alt=""
			widths={[640, 1000, 1400, 1698]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__tint" aria-hidden="true"></div>
		<div class="hero__veil" aria-hidden="true"></div>
		<div class="hero__sun" aria-hidden="true"></div>

		<div class="container container--wide hero__inner">
			<div class="hero__text">
				<h1 class="reveal-lines">Podiatry care in Wonthaggi since 2007</h1>
				<p class="hero__lead reveal">
					Bass Coast Podiatry is open 5 days per week and is able to meet any special requirements of those needing urgent foot care.
				</p>
				<div class="btn-row reveal">
					<a class="btn btn--white btn--icon" href={clinic.phoneHref}>
						<Icon name="phone" />
						Call {clinic.phone}
					</a>
					<a class="btn btn--ghost-white" href={url('/contact/#message')} data-contact>Contact us</a>
				</div>
			</div>

			<aside class="visit-card glass reveal" aria-labelledby="visit-card-title">
				<h2 id="visit-card-title">Visit us</h2>
				<div class="visit-card__row">
					<span class="icon-circle"><Icon name="clock" size={24} /></span>
					<div>
						<p class="visit-card__today" data-today>
							{clinic.hours[0].days}, {clinic.hours[0].time}
						</p>
						<p class="visit-card__small" data-today-note>{clinic.hoursNote}</p>
					</div>
				</div>
				<div class="visit-card__row">
					<span class="icon-circle"><Icon name="pin" size={24} /></span>
					<div>
						<p class="visit-card__strong">{clinic.street}</p>
						<p class="visit-card__small">{clinic.suburb}</p>
					</div>
				</div>
				<div class="visit-card__row">
					<span class="icon-circle"><Icon name="phone" size={24} /></span>
					<p class="visit-card__strong"><a href={clinic.phoneHref}>{clinic.phone}</a></p>
				</div>
				<a class="btn visit-card__btn" href={clinic.directions} rel="noopener">Get directions</a>
			</aside>
		</div>
	</section>

	<QuickActions />

	<section class="section services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal-lines">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<div class="container container--wide team__inner">
			<div class="zoom-frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal-lines">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this team list still current?</span></p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal-lines">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal-lines">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<div class="container container--wide faq__inner">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal-lines">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Today's hours in the Visit us card, worked out in Wonthaggi's time zone.
	import { clinic } from '../data/site';

	function showToday() {
		const el = document.querySelector('[data-today]');
		if (!el) return;
		const day = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short' }).format(new Date());
		const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
		const open = (clinic.openDays as readonly number[]).includes(index);
		el.textContent = open ? `Open today, ${clinic.openTime} to ${clinic.closeTime}` : 'Closed today';
		const note = document.querySelector('[data-today-note]');
		if (note && !open) note.textContent = `Open ${clinic.hours[0].days}, ${clinic.hours[0].time}.`;
	}

	document.addEventListener('astro:page-load', showToday);
</script>

<style>
	/* Hero: the beach photo fills the screen width, with an Ocean blue glass veil deepest on the left */

	/* Height is set against the screen below the header, so the quick actions overlapping the
	   bottom edge stay above the fold on common laptop sizes. The headline sits near the top. */
	.hero {
		position: relative;
		display: grid;
		align-items: start;
		min-height: min(72svh, 720px);
		padding-block: clamp(1.5rem, 4.5vh, 3rem) clamp(4.75rem, 9.5vh, 6rem);
		overflow: clip;
		background: var(--bcp-deep);
		color: var(--bcp-white);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% 50%;
	}

	/* Frosted blue glass over the photo, so the white text sits on a calm, strong surface */
	.hero__veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--bcp-deep) 90%, transparent) 0%,
			color-mix(in srgb, var(--bcp-deep) 82%, transparent) 38%,
			color-mix(in srgb, var(--bcp-blue) 45%, transparent) 62%,
			color-mix(in srgb, var(--bcp-blue) 12%, transparent) 100%
		);
		-webkit-backdrop-filter: blur(14px) saturate(120%);
		backdrop-filter: blur(14px) saturate(120%);
		-webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 85%);
		mask-image: linear-gradient(90deg, #000 45%, transparent 85%);
	}

	/* A second, unblurred tint keeps the right side of the photo gently blue */
	.hero__tint {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, color-mix(in srgb, var(--bcp-deep) 70%, transparent), color-mix(in srgb, var(--bcp-blue) 15%, transparent));
	}

	/* Warm sand light near the bottom, like sunlight on sand */
	.hero__sun {
		position: absolute;
		inset: auto 0 -35% 0;
		height: 60%;
		background: radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--bcp-sand) 45%, transparent), transparent 65%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: var(--space-l);
		align-items: center;
	}

	@media (min-width: 64rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr) 25rem;
			gap: var(--space-xl);
		}
	}

	.hero h1 {
		max-width: 12ch;
		margin-bottom: var(--space-m);
		color: var(--bcp-white);
		/* Large, but also limited by screen height so short laptop screens keep the cards in view */
		font-size: clamp(2.5rem, min(1.4rem + 5.2vw, 10.5vh), 6.25rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.hero__lead {
		max-width: 38rem;
		margin-bottom: clamp(1.25rem, 3.5vh, 2.5rem);
		font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
		line-height: 1.55;
	}

	/* Phones: the photo stays behind both the headline and the card, with an even veil */
	@media (max-width: 63.99rem) {
		.hero {
			min-height: 0;
			padding-top: var(--space-m);
		}

		.hero__veil {
			-webkit-mask-image: none;
			mask-image: none;
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--bcp-deep) 88%, transparent),
				color-mix(in srgb, var(--bcp-deep) 70%, transparent) 60%,
				color-mix(in srgb, var(--bcp-blue) 55%, transparent)
			);
		}
	}

	/* Visit us card: frosted white glass with dark text */
	.visit-card {
		display: grid;
		gap: var(--space-m);
		padding: clamp(1.5rem, 2.5vw, 2.25rem);
		border-radius: var(--bcp-radius-large);
		background: color-mix(in srgb, var(--bcp-white) 88%, transparent);
		color: var(--bcp-ink);
	}

	.visit-card h2 {
		margin: 0;
		font-size: 1.625rem;
	}

	.visit-card :focus-visible {
		outline-color: var(--bcp-blue);
	}

	.visit-card__row {
		display: flex;
		align-items: center;
		gap: var(--space-s);
	}

	.visit-card__row p {
		margin: 0;
	}

	.visit-card__row .icon-circle {
		width: 3rem;
		height: 3rem;
	}

	.visit-card__today,
	.visit-card__strong {
		color: var(--bcp-blue);
		font-weight: var(--bcp-weight-heading);
		line-height: 1.35;
	}

	.visit-card__strong a {
		color: var(--bcp-blue);
	}

	.visit-card__small {
		color: var(--bcp-grey);
		line-height: 1.45;
	}

	.visit-card__btn {
		justify-self: start;
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.team__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
