---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { clinic, nav, url } from '../data/site';

const servicePaths = (await getCollection('services')).map((s) => url(`/${s.id}/`));
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
	const full = url(href);
	if (href === '/our-services/' && servicePaths.includes(path)) return true;
	return path === full;
};
---

<header class="site-header">
	<div class="container container--wide site-header__inner">
		<a class="site-header__logo" href={url('/')}>
			<img class="logo-blue" src={url('/bcp-logo-horizontal-blue.svg')} alt="Bass Coast Podiatry home" width="365" height="130" />
			<img class="logo-white" src={url('/bcp-logo-horizontal-white.svg')} alt="" width="365" height="130" />
		</a>

		<nav class="site-nav" id="site-nav" aria-label="Main">
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="btn btn--icon site-header__call" href={clinic.phoneHref}>
				<Icon name="phone" />
				Call {clinic.phone}
			</a>
		</nav>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
			<span class="menu-toggle__bars" aria-hidden="true"></span>
			<span class="menu-toggle__label">Menu</span>
		</button>
	</div>
</header>

<script>
	// Compact frosted header once the page scrolls.
	let ticking = false;
	const updateHeader = () => {
		document.querySelector('.site-header')?.classList.toggle('is-compact', window.scrollY > 24);
		ticking = false;
	};
	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(updateHeader);
			}
		},
		{ passive: true },
	);
	document.addEventListener('astro:page-load', updateHeader);

	// Full screen menu on phones and tablets.
	const setOpen = (open: boolean) => {
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
		const header = document.querySelector('.site-header');
		if (!toggle || !header) return;
		toggle.setAttribute('aria-expanded', String(open));
		const label = toggle.querySelector('.menu-toggle__label');
		if (label) label.textContent = open ? 'Close' : 'Menu';
		header.classList.toggle('menu-open', open);
		document.documentElement.classList.toggle('no-scroll', open);
		// Keep keyboard focus inside the menu while it is open.
		document.querySelectorAll('main, footer, .mobile-call').forEach((el) => el.toggleAttribute('inert', open));
		if (open) document.querySelector<HTMLAnchorElement>('#site-nav a')?.focus();
	};

	document.addEventListener('click', (event) => {
		const toggle = (event.target as HTMLElement).closest('.menu-toggle');
		if (toggle) setOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	document.addEventListener('keydown', (event) => {
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
		if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			toggle.focus();
		}
	});

	document.addEventListener('astro:before-swap', () => document.documentElement.classList.remove('no-scroll'));
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
	}

	/* The frosted background lives on a pseudo element, so the fixed mobile menu is not trapped inside the header. */
	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: color-mix(in srgb, var(--bcp-white) 0%, transparent);
		border-bottom: 1px solid transparent;
		transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
	}

	.site-header.is-compact::before {
		background: color-mix(in srgb, var(--bcp-white) 72%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(150%);
		backdrop-filter: blur(16px) saturate(150%);
		border-bottom-color: color-mix(in srgb, var(--bcp-blue) 8%, transparent);
		box-shadow: 0 8px 30px color-mix(in srgb, var(--bcp-deep) 6%, transparent);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		min-height: 6rem;
		transition: min-height 0.35s var(--ease);
	}

	.is-compact .site-header__inner {
		min-height: 4.5rem;
	}

	.site-header__logo {
		position: relative;
		z-index: 2;
		flex: none;
	}

	.site-header__logo img {
		width: 177px;
		height: auto;
		transition: width 0.35s var(--ease);
	}

	.is-compact .site-header__logo img {
		width: 149px;
	}

	.logo-white {
		display: none;
	}

	.menu-toggle {
		display: none;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-l);
	}

	.site-nav ul {
		display: flex;
		gap: 0.25rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav ul a {
		position: relative;
		display: inline-block;
		padding-block: 0.5rem;
		color: var(--bcp-ink);
		text-decoration: none;
	}

	.site-nav ul a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.2rem;
		height: 2px;
		border-radius: 2px;
		background: var(--bcp-blue);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s var(--ease);
	}

	.site-nav ul a:hover {
		color: var(--bcp-blue);
	}

	.site-nav ul a:hover::after {
		transform: scaleX(1);
	}

	/* The single sand accent: the current page marker */
	.site-nav ul a[aria-current='page'] {
		color: var(--bcp-blue);
	}

	.site-nav ul a[aria-current='page']::after {
		background: var(--bcp-sand);
		height: 3px;
		transform: scaleX(1);
	}

	/* Medium desktops: slightly tighter menu so every label stays on one line */
	@media (min-width: 68.75rem) and (max-width: 79.99rem) {
		.site-nav {
			gap: var(--space-m);
		}

		.site-nav ul {
			column-gap: 1.5rem;
		}
	}

	.site-nav ul a,
	.site-header__call {
		white-space: nowrap;
	}

	/* Phones, tablets and small laptops (under 1100px): full screen deep blue menu. At 1024px the full menu
	   and Call button do not fit on one line. Without JS the list just shows. */
	@media (max-width: 68.74rem) {
		.site-header__inner {
			min-height: 4.75rem;
		}

		.site-header__logo img,
		.is-compact .site-header__logo img {
			width: 160px;
		}

		:global(.js) .menu-toggle {
			position: relative;
			z-index: 2;
			display: inline-flex;
			align-items: center;
			gap: 0.65rem;
			min-height: 3rem;
			padding: 0.5rem 1.15rem;
			border: 1px solid color-mix(in srgb, var(--bcp-blue) 25%, transparent);
			border-radius: var(--bcp-radius-button);
			background: color-mix(in srgb, var(--bcp-white) 80%, transparent);
			color: var(--bcp-blue);
			font: inherit;
			font-weight: var(--bcp-weight-heading);
			cursor: pointer;
		}

		.menu-toggle__bars,
		.menu-toggle__bars::before,
		.menu-toggle__bars::after {
			display: block;
			width: 1.1rem;
			height: 2px;
			background: currentColor;
			border-radius: 2px;
			transition: transform 0.3s var(--ease), opacity 0.2s;
		}

		.menu-toggle__bars {
			position: relative;
		}

		.menu-toggle__bars::before,
		.menu-toggle__bars::after {
			content: '';
			position: absolute;
			left: 0;
		}

		.menu-toggle__bars::before {
			top: -6px;
		}

		.menu-toggle__bars::after {
			top: 6px;
		}

		.menu-open .menu-toggle__bars {
			background: transparent;
		}

		.menu-open .menu-toggle__bars::before {
			transform: translateY(6px) rotate(45deg);
		}

		.menu-open .menu-toggle__bars::after {
			transform: translateY(-6px) rotate(-45deg);
		}

		.site-nav {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-l);
		}

		:global(.js) .site-nav {
			position: fixed;
			inset: 0;
			z-index: 1;
			justify-content: center;
			padding: 6.5rem var(--gutter) 3rem;
			overflow-y: auto;
			background: var(--bcp-deep);
			visibility: hidden;
			opacity: 0;
			transition: opacity 0.3s var(--ease), visibility 0s linear 0.3s;
		}

		:global(.js) .menu-open .site-nav {
			visibility: visible;
			opacity: 1;
			transition: opacity 0.3s var(--ease), visibility 0s;
		}

		.site-nav ul {
			flex-direction: column;
			gap: 0.25rem;
		}

		:global(.js) .site-nav ul a {
			color: var(--bcp-white);
			font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
			font-weight: var(--bcp-weight-text);
			line-height: 1.25;
			letter-spacing: -0.02em;
		}

		:global(.js) .site-nav ul a::after {
			background: var(--bcp-white);
		}

		:global(.js) .site-nav :focus-visible {
			outline-color: var(--bcp-white);
		}

		:global(.js) .site-header__call {
			background: var(--bcp-white);
			border-color: var(--bcp-white);
			color: var(--bcp-blue);
		}

		.menu-open .logo-blue {
			display: none;
		}

		.menu-open .logo-white {
			display: block;
		}

		.menu-open .menu-toggle {
			background: transparent;
			border-color: color-mix(in srgb, var(--bcp-white) 50%, transparent);
			color: var(--bcp-white);
		}

		.menu-open .menu-toggle:focus-visible {
			outline-color: var(--bcp-white);
		}
	}

	:global(html.no-scroll) {
		overflow: hidden;
	}
</style>
