---
import { faqs } from '../data/site';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<div class="accordion">
	{
		items.map((faq, i) => (
			<details open={i === 0}>
				<summary>{faq.question}</summary>
				<div class="answer">
					{faq.answer.map((para) => (
						<p>{para}</p>
					))}
				</div>
			</details>
		))
	}
</div>
