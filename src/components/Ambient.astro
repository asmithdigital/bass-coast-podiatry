---
// Moving background fixed behind the whole page, over a white to very light base (set on body), with four separate soft
// blobs of coloured light (Ocean blue, Sea cyan, Soft green and a little Sand). Each one drifts, grows and
// shrinks on its own path, like a lava lamp, on a 16 to 24 second loop, with white space between them.
// CSS only, and only `transform` is animated, so it runs on the GPU without repainting.
// Ocean blue is kept the palest, so Ink body text and Ocean blue headings keep strong contrast on top.
// It stands still with reduce motion, and pauses while the tab is hidden (script in Layout.astro).
---

<div class="ambient" aria-hidden="true" transition:persist="ambient">
	<span class="blob blob--sea"></span>
	<span class="blob blob--blue"></span>
	<span class="blob blob--mint"></span>
	<span class="blob blob--sand"></span>
</div>

<style is:global>
	.ambient {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		contain: strict;
		/* See-through: the white base is on the page (global.css), so the home hero photo can sit underneath */
	}

	.blob {
		position: absolute;
		top: var(--y);
		left: var(--x);
		width: var(--s);
		aspect-ratio: 1;
		border-radius: 50%;
		/* A soft core that fades out over most of the radius gives very fuzzy edges without a blur filter */
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--c) calc(var(--a) * 100%), transparent) 0%,
			color-mix(in srgb, var(--c) calc(var(--a) * 70%), transparent) 30%,
			color-mix(in srgb, var(--c) calc(var(--a) * 25%), transparent) 65%,
			transparent 100%
		);
		translate: -50% -50%;
		will-change: transform;
	}

	/* Sizes are about 30 to 45% of the screen width, with a floor so they still read on phones */
	.blob--sea {
		--c: var(--bcp-sea);
		--a: 0.8;
		--s: max(45vw, 11rem);
		--x: 80%;
		--y: 22%;
	}

	.blob--blue {
		--c: var(--bcp-blue);
		--a: 0.3;
		--s: max(40vw, 10rem);
		--x: 14%;
		--y: 58%;
	}

	.blob--mint {
		--c: var(--bcp-mint);
		--a: 0.75;
		--s: max(38vw, 9.5rem);
		--x: 62%;
		--y: 88%;
	}

	.blob--sand {
		--c: var(--bcp-sand);
		--a: 0.55;
		--s: max(30vw, 8rem);
		--x: 34%;
		--y: 12%;
	}

	@media (prefers-reduced-motion: no-preference) {
		.blob--sea {
			animation: lava-sea 20s ease-in-out infinite;
		}

		.blob--blue {
			animation: lava-blue 24s ease-in-out infinite;
		}

		.blob--mint {
			animation: lava-mint 17s ease-in-out infinite;
		}

		.blob--sand {
			animation: lava-sand 22s ease-in-out infinite;
		}

		/* Paused while the tab is hidden */
		.ambient-paused .blob {
			animation-play-state: paused;
		}
	}

	/* Each blob has its own path: drift, grow and shrink */
	@keyframes lava-sea {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		33% {
			transform: translate3d(-16vw, 14vh, 0) scale(1.3);
		}
		66% {
			transform: translate3d(-4vw, 30vh, 0) scale(0.8);
		}
	}

	@keyframes lava-blue {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(0.9);
		}
		40% {
			transform: translate3d(18vw, -20vh, 0) scale(1.25);
		}
		70% {
			transform: translate3d(8vw, 12vh, 0) scale(0.75);
		}
	}

	@keyframes lava-mint {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1.1);
		}
		30% {
			transform: translate3d(-20vw, -18vh, 0) scale(0.8);
		}
		65% {
			transform: translate3d(12vw, -30vh, 0) scale(1.3);
		}
	}

	@keyframes lava-sand {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		50% {
			transform: translate3d(14vw, 22vh, 0) scale(1.35);
		}
		80% {
			transform: translate3d(-8vw, 8vh, 0) scale(0.85);
		}
	}
</style>
