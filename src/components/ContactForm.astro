---
// The contact form, used on the Contact page and in the contact panel.
import { clinic } from '../data/site';

interface Props {
	/** Keeps field ids unique when the form appears twice on a page. */
	idPrefix?: string;
	compact?: boolean;
}

const { idPrefix = 'cf', compact = false } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;
// Until the real Formspree form ID is set in site.ts, the form shows a friendly note instead of sending.
const isPreview = clinic.formspreeId === 'YOUR_FORM_ID';
---

<form
	class:list={['contact-form', { 'contact-form--compact': compact }]}
	data-astro-reload
	data-preview-form={isPreview ? '' : undefined}
	action={`https://formspree.io/f/${clinic.formspreeId}`}
	method="POST"
>
	<div class="contact-form__row">
		<div class="field">
			<label for={id('name')}>Your name</label>
			<input class="input" id={id('name')} name="name" type="text" autocomplete="name" required />
		</div>
		<div class="field">
			<label for={id('phone')}>Phone number</label>
			<input class="input" id={id('phone')} name="phone" type="tel" autocomplete="tel" required />
		</div>
	</div>
	<div class="field">
		<label for={id('email')}>Email address <span class="hint">(optional)</span></label>
		<input class="input" id={id('email')} name="email" type="email" autocomplete="email" />
	</div>
	<div class="field">
		<label for={id('message')}>Message</label>
		<span class="hint" id={id('message-hint')}>Let us know if you would like an appointment and what times suit you.</span>
		<textarea class="input" id={id('message')} name="message" required aria-describedby={id('message-hint')}></textarea>
	</div>
	<input type="hidden" name="_subject" value="Website message for Bass Coast Podiatry" />
	<button class="btn" type="submit">Send message</button>
	<p class="contact-form__thanks" role="status" tabindex="-1" hidden>
		Thanks. This is a preview, so messages aren't sent yet. Please call us on <a href={clinic.phoneHref}>{clinic.phone}</a>.
	</p>
</form>

<script>
	// Preview only: show the thank you note instead of sending. Delegated, so it works after page changes
	// and for the form in the contact panel.
	const w = window as unknown as { __bcpPreviewForm?: boolean };
	if (!w.__bcpPreviewForm) {
		w.__bcpPreviewForm = true;
		document.addEventListener('submit', (event) => {
			const form = event.target as HTMLFormElement;
			if (!form.matches?.('form[data-preview-form]')) return;
			event.preventDefault();
			const note = form.querySelector<HTMLElement>('.contact-form__thanks');
			if (!note) return;
			note.hidden = false;
			note.focus();
			form.reset();
		});
	}
</script>

<style>
	.contact-form__row {
		display: grid;
		gap: 0 var(--space-m);
	}

	@media (min-width: 40rem) {
		.contact-form__row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.contact-form--compact .field {
		margin-bottom: var(--space-s);
	}

	.contact-form--compact textarea.input {
		min-height: 7rem;
	}

	.contact-form__thanks {
		margin: var(--space-m) 0 0;
		padding: var(--space-s) var(--space-m);
		border-radius: var(--bcp-radius);
		background: var(--tint);
		color: var(--bcp-ink);
		font-weight: var(--bcp-weight-heading);
	}

	.contact-form__thanks:focus {
		outline: none;
	}
</style>
