---
import Icon from './Icon.astro';
import { clinic } from '../data/site';

interface Props {
	headingLevel?: 'h2' | 'h3';
}

const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div class="visit">
	<div class="visit__details glass reveal">
		<div class="visit__item">
			<span class="icon-circle visit__icon"><Icon name="clock" size={26} /></span>
			<div>
				<Heading>Opening hours</Heading>
				<ul class="hours">
					{
						clinic.hours.map((h) => (
							<li>
								<span>{h.days}</span>
								<span>{h.time}</span>
							</li>
						))
					}
				</ul>
				<p>{clinic.hoursNote}</p>
			</div>
		</div>
		<div class="visit__item">
			<span class="icon-circle visit__icon"><Icon name="pin" size={26} /></span>
			<div>
				<Heading>Address</Heading>
				<p>
					{clinic.street}<br />
					{clinic.suburb}
				</p>
				<p><a href={clinic.directions} rel="noopener">Get directions on Google Maps</a></p>
			</div>
		</div>
		<div class="visit__item">
			<span class="icon-circle visit__icon"><Icon name="phone" size={26} /></span>
			<div>
				<Heading>Phone</Heading>
				<p><a href={clinic.phoneHref}>{clinic.phone}</a></p>
			</div>
		</div>
	</div>
	<iframe
		class="map reveal"
		src={clinic.mapEmbed}
		title="Map showing Bass Coast Podiatry at 182 Graham Street, Wonthaggi"
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<style>
	.visit {
		position: relative;
		z-index: 1;
		display: grid;
		gap: var(--space-m);
	}

	/* Desktop: a wide map panel with the details card overlapping its right edge, clear of the map's own labels */
	@media (min-width: 64rem) {
		.visit {
			grid-template-columns: repeat(12, 1fr);
			align-items: center;
		}

		.visit__details {
			grid-column: 8 / -1;
			grid-row: 1;
			z-index: 1;
		}

		.map {
			grid-column: 1 / span 9;
			grid-row: 1;
			aspect-ratio: 16 / 10;
		}
	}

	.visit__details {
		display: grid;
		gap: var(--space-m);
		padding: clamp(1.75rem, 3vw, 2.5rem);
		border-radius: var(--bcp-radius-large);
		background: color-mix(in srgb, var(--bcp-white) 92%, transparent);
	}

	.visit__item {
		display: flex;
		gap: var(--space-s);
	}

	.visit__item :global(h2),
	.visit__item :global(h3) {
		font-size: 1.25rem;
		margin-bottom: var(--space-xs);
	}

	.visit__item p:last-child {
		margin-bottom: 0;
	}

	.visit__item .hours {
		margin-bottom: var(--space-xs);
	}

	.visit__icon {
		width: 3.25rem;
		height: 3.25rem;
	}

	.map {
		box-shadow: var(--shadow);
	}
</style>
