---
// The most common reasons people visit, in plain words, each linking to its service page.
// [CHECK WITH CLIENT] Confirm these are the four most popular services.
import Icon from './Icon.astro';
import { url } from '../data/site';

const reasons = [
	{
		title: 'Ingrown toenails, corns and calluses',
		line: 'Also warts and thickened or discoloured nails.',
		href: '/general-podiatry/',
		icon: 'general',
	},
	{
		title: 'Orthotics',
		line: 'Prescription orthoses for heel, knee and foot pain.',
		href: '/prescription-orthotic-therapy/',
		icon: 'orthotics',
	},
	{
		title: 'Diabetes foot checks',
		line: 'Circulation, sensation and general foot health.',
		href: '/diabetes-foot-assessment/',
		icon: 'diabetes',
	},
	{
		title: "Children's feet",
		line: 'Assessment, treatment and advice for parents.',
		href: '/paediatric-assessment/',
		icon: 'children',
	},
] as const;
---

<section class="reasons container container--wide" aria-labelledby="reasons-title">
	<h2 id="reasons-title" class="visually-hidden">Common reasons people visit</h2>
	<ul role="list">
		{
			reasons.map((r) => (
				<li class="reason glass">
					<div class="reason__top">
						<span class="icon-circle">
							<Icon name={r.icon} size={26} />
						</span>
						<span class="reason__arrow" aria-hidden="true">
							<Icon name="arrowUpRight" size={20} />
						</span>
					</div>
					<h3>
						<a href={url(r.href)}>{r.title}</a>
					</h3>
					<p>{r.line}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.reasons {
		position: relative;
		z-index: 1;
		margin-top: clamp(1rem, 2.5vh, 1.5rem);
	}

	.reasons ul {
		display: grid;
		gap: clamp(0.75rem, 1.2vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.reasons ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 72rem) {
		.reasons ul {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.reason {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: clamp(1rem, 1.4vw, 1.4rem);
		border-radius: var(--bcp-radius-panel);
		translate: 0 0;
		transition: translate 0.4s var(--ease), box-shadow 0.4s var(--ease);
	}

	.reason:hover {
		translate: 0 -4px;
		box-shadow: var(--shadow-lift);
	}

	.reason .icon-circle {
		width: 3rem;
		height: 3rem;
	}

	.reason__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}

	.reason h3 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.reason h3 a {
		color: var(--bcp-blue);
		text-decoration: none;
	}

	/* The whole card is clickable through the title link */
	.reason h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--bcp-radius-panel);
	}

	.reason h3 a:focus-visible {
		outline: none;
	}

	.reason h3 a:focus-visible::after {
		outline: 3px solid var(--bcp-blue);
		outline-offset: 3px;
	}

	.reason p {
		margin: 0;
		color: var(--bcp-ink);
		line-height: 1.45;
	}

	.reason__arrow {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid color-mix(in srgb, var(--bcp-blue) 35%, transparent);
		border-radius: 50%;
		color: var(--bcp-blue);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.reason:hover .reason__arrow {
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	@media (prefers-reduced-motion: reduce) {
		.reason,
		.reason:hover {
			translate: none;
		}
	}
</style>
