---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Bass Coast Podiatry in Wonthaggi has provided podiatry care since 2007. Open Monday to Friday. Call (03) 5672 2309.">
	<section class="hero">
		<!-- Lightly faded beach photo behind the hero only. It sits beneath the moving glow and scrolls away with the hero. -->
		<div class="hero__bg" aria-hidden="true">
			<Image src={heroImage} alt="" widths={[800, 1280, 1698]} sizes="100vw" loading="eager" fetchpriority="high" />
		</div>

		<div class="container container--wide hero__grid">
			<div class="hero__main">
				<h1 class="hero__title reveal-lines">Podiatry care in Wonthaggi since 2007</h1>
				<p class="hero__lead reveal">
					Bass Coast Podiatry is open 5 days per week and is able to meet any special requirements of those needing urgent foot care.
				</p>
			</div>

			<div class="hero__cards">
				<article class="hcard hcard--visit glass reveal" aria-labelledby="visit-card-title">
					<div class="hcard__head">
						<span class="icon-circle"><Icon name="clock" size={24} /></span>
						<h2 id="visit-card-title">Visit us</h2>
					</div>
					<p class="hcard__closed" data-closed-today hidden>Closed today</p>
					<p class="hcard__hours">
						<span>Open {clinic.hours[0].days}</span>
						<span>{clinic.hours[0].time}</span>
					</p>
					<p class="hcard__address">
						{clinic.street}, {clinic.suburb}
						<a class="hcard__directions" href={clinic.directions} rel="noopener">Get directions</a>
					</p>
					<div class="hcard__actions">
						<a class="btn btn--icon" href={clinic.phoneHref} data-hero-call>
							<Icon name="phone" />
							Call {clinic.phone}
						</a>
						<a class="btn btn--outline btn--icon" href={url('/contact/#message')} data-contact>
							<Icon name="message" />
							Send us a message
						</a>
					</div>
				</article>

					<article class="bento bento--claims on-blue reveal" aria-labelledby="claims-card-title">
						<span class="bento__corner" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
						<h2 id="claims-card-title">Claims and rebates</h2>
						<p>
							<a class="bento__stretch" href={url('/claims-rebates/')}>Medicare, DVA, HICAPS, TAC and WorkSafe</a>
						</p>
					</article>

			</div>
		</div>
	</section>

	<section class="section services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal-lines">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature plainNames />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="soft" />
		<div class="container container--wide team__inner above-glow">
			<div class="zoom-frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal-lines">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this team list still current?</span></p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal-lines">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal-lines">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="soft" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal-lines">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Shows "Closed today" in the Visit us card on days the clinic is closed, worked out in Wonthaggi's time zone.
	import { clinic } from '../data/site';

	function showToday() {
		const el = document.querySelector<HTMLElement>('[data-closed-today]');
		if (!el) return;
		const day = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short' }).format(new Date());
		const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
		el.hidden = (clinic.openDays as readonly number[]).includes(index);
	}

	document.addEventListener('astro:page-load', showToday);
</script>

<style>
	/* Hero: fills the screen below the header, over a lightly faded beach photo. Left (about 60%) the headline
	   and intro on a soft white glow; right (about 35%) Visit us above Claims and rebates. The content sits a
	   little above the vertical middle. */

	.hero {
		--header-h: 4.75rem;
		position: relative;
		display: grid;
		align-items: center;
		min-height: calc(100svh - var(--header-h));
		/* The soft glow behind the text must not widen the page on phones */
		overflow-x: clip;
		/* More space below than above lifts the content just above the middle */
		padding-block: clamp(2rem, 4vh, 3rem) clamp(4rem, 13vh, 8rem);
	}

	@media (min-width: 64rem) {
		.hero {
			--header-h: 6rem;
		}
	}

	/* The photo sits under the moving glow (z-index -2, the glow is -1) with a 55% white veil, so the beach
	   and footprints show clearly. The text gets its own soft white glow (see .hero__main). */
	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;
	}

	.hero__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 50%;
	}

	.hero__bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--bcp-white) 55%, transparent);
	}

	.hero__grid {
		display: grid;
		gap: var(--space-l) 5%;
		align-items: center;
	}

	@media (min-width: 64rem) {
		.hero__grid {
			grid-template-columns: 60fr 35fr;
		}
	}

	/* Soft white glow behind the headline and intro only, so the photo is lighter right behind the words.
	   It fades out at the edges, so it never reads as a box. */
	.hero__main {
		position: relative;
		isolation: isolate;
	}

	.hero__main::before {
		content: '';
		position: absolute;
		inset: -22% -14% -26% -18%;
		z-index: -1;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--bcp-white) 92%, transparent) 0%,
			color-mix(in srgb, var(--bcp-white) 84%, transparent) 55%,
			color-mix(in srgb, var(--bcp-white) 40%, transparent) 82%,
			transparent 100%
		);
		pointer-events: none;
	}

	.hero__title {
		color: var(--bcp-deep);
		margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
		font-size: clamp(2.25rem, 0.85rem + 4.25vw, 4.65rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
	}

	.hero__lead {
		max-width: 36rem;
		margin-bottom: var(--space-m);
		margin-bottom: 0;
		font-size: 1.25rem;
		line-height: 1.55;
		color: var(--bcp-deep);
	}

	/* Visit us above the smaller Claims card, vertically aligned with the heading */
	.hero__cards {
		display: grid;
		gap: clamp(0.75rem, 1.2vw, 1rem);
	}

	.bento {
		position: relative;
		border-radius: var(--bcp-radius-panel);
	}

	.bento--claims {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: clamp(1rem, 1.4vw, 1.35rem);
	}

	.bento h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.bento p {
		margin: 0;
	}

	/* Visit us: frosted glass that turns solid white on hover */
	.hcard {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: clamp(1.25rem, 1.8vw, 1.75rem);
		border-radius: var(--bcp-radius-panel);
		transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
	}

	.hcard--visit.glass {
		background: color-mix(in srgb, var(--bcp-white) 72%, transparent);
	}

	.hcard--visit.glass:hover,
	.hcard--visit.glass:focus-within {
		background: var(--bcp-white);
		box-shadow: var(--shadow-lift);
	}

	.hcard h2 {
		margin: 0;
		font-size: clamp(1.375rem, 1.1rem + 0.6vw, 1.75rem);
		line-height: 1.25;
	}

	.hcard p {
		margin: 0;
	}

	.hcard__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.6rem;
	}

	.hcard__head .icon-circle {
		width: 2.75rem;
		height: 2.75rem;
	}

	.hcard__closed {
		color: var(--bcp-blue);
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__hours span {
		display: block;
		line-height: 1.45;
	}

	.hcard__hours span:first-child {
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__address {
		margin-top: 0.6rem !important;
		line-height: 1.45;
	}

	.hcard__directions {
		display: inline-block;
		margin-left: 0.25rem;
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.hcard__actions .btn {
		min-height: 3.25rem;
		padding: 0.7rem 1.25rem;
	}

	/* Small solid Ocean blue card, the blue card style from the style guide */
	.bento--claims {
		padding-right: 3.5rem;
		background: var(--bcp-blue);
		color: var(--bcp-white);
		box-shadow: var(--shadow);
	}

	.bento--claims h2 {
		color: var(--bcp-white);
		font-size: 1.125rem;
	}

	.bento__corner {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--bcp-white) 55%, transparent);
		border-radius: 50%;
		color: var(--bcp-white);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.bento--claims:hover .bento__corner {
		background: var(--bcp-white);
		color: var(--bcp-blue);
	}

	/* The whole Claims card is clickable through its link */
	.bento__stretch {
		color: var(--bcp-white);
		text-decoration: none;
		line-height: 1.45;
	}

	.bento__stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--bcp-radius-panel);
	}

	.bento__stretch:focus-visible {
		outline: none;
	}

	.bento__stretch:focus-visible::after {
		outline: 3px solid var(--bcp-white);
		outline-offset: 3px;
	}

	.bento--claims:hover .bento__stretch {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.team__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
