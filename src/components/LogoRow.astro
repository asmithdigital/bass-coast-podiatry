---
// A clean row of partner and membership logos in one muted style. Logos turn to colour on hover.
// Organisations whose logo is not cleared for use show as a matching text tile (see partners in site.ts).
import { Image } from 'astro:assets';
import { partners } from '../data/site';

interface Props {
	label?: string;
}

const { label = 'Claims, rebates and memberships' } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.jpg', { eager: true });
const logoFor = (file: string) => files[`../assets/logos/${file}`]?.default;
---

<ul class="logo-row" aria-label={label}>
	{
		partners.map((p) => (
			<li class="logo-row__item">
				{p.showLogo && logoFor(p.file) ? (
					<Image src={logoFor(p.file)!} alt={p.name} height={75} />
				) : (
					<span class="logo-row__text">{p.name}</span>
				)}
			</li>
		))
	}
</ul>
<p class="logo-row__note">
	Our podiatrists are registered with the Podiatry Board of Australia through AHPRA.
	<span class="check">[CHECK WITH CLIENT] Confirm this wording, and that you may use each logo shown.</span>
</p>

<style>
	.logo-row {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin: 0 0 var(--space-m);
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.logo-row {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (min-width: 80rem) {
		.logo-row {
			grid-template-columns: repeat(8, 1fr);
		}
	}

	.logo-row__item {
		display: grid;
		place-items: center;
		min-height: 6rem;
		padding: 1rem;
		border: var(--border);
		border-radius: var(--bcp-radius);
		background: var(--bcp-white);
	}

	.logo-row__item img {
		width: auto;
		max-width: 100%;
		max-height: 3.25rem;
		/* Muted: greyscale, and the white JPEG background blends into the white tile */
		filter: grayscale(1) contrast(1.25) brightness(0.9);
		opacity: 0.9;
		mix-blend-mode: multiply;
		transition: filter 0.4s var(--ease), opacity 0.4s var(--ease);
	}

	.logo-row__item:hover img {
		filter: none;
		opacity: 1;
	}

	.logo-row__text {
		color: var(--bcp-grey);
		font-weight: var(--bcp-weight-heading);
		font-size: 1.125rem;
		line-height: 1.25;
		text-align: center;
		letter-spacing: 0.01em;
	}

	.logo-row__note {
		max-width: var(--width-text);
		color: var(--bcp-grey);
	}

	.logo-row__note .check {
		margin-top: var(--space-xs);
	}
</style>
