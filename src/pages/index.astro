---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Podiatry in Wonthaggi since 2007. Bass Coast Podiatry is open Monday to Friday and no referral is needed. Call (03) 5672 2309.">
	<section class="hero">
		<!-- Faded beach photo behind the whole hero. No glow blobs here: they only sit in the sections below. -->
		<div class="hero__bg" aria-hidden="true">
			<Image src={heroImage} alt="" widths={[800, 1280, 1698]} sizes="100vw" loading="eager" fetchpriority="high" />
		</div>

		<div class="container container--wide hero__grid">
			<div class="hero__main">
				<h1 class="hero__title reveal">Expert foot care in Wonthaggi</h1>
				<p class="hero__line reveal">No referral needed. Open five days a week.</p>
				<p class="hero__lead reveal">Caring for feet on the Bass Coast since 2007.</p>
				<a class="btn reveal" href={url('/our-services/')}>Our services</a>
			</div>

			<!-- One solid white card: contact details on the left, a static map panel on the right (a strip above the band on
			     phones), and a solid Ocean blue band across the bottom linking to Claims and rebates. -->
			<article class="hero-card frame reveal" aria-label="Visit us">
				<div class="hero-card__body">
					<ul class="hero-card__list" role="list">
						<li>
							<span class="icon-circle"><Icon name="clock" size={22} /></span>
							<p>
								<strong>{clinic.hours[0].days}</strong>
								<span>{clinic.hours[0].time}</span>
							</p>
						</li>
						<li>
							<span class="icon-circle"><Icon name="pin" size={22} /></span>
							<p>
								<span>{clinic.street},</span>
								<span>{clinic.suburb}</span>
							</p>
						</li>
					</ul>
					<a class="btn btn--icon" href={clinic.phoneHref} data-hero-call>
						<Icon name="phone" />
						Call {clinic.phone}
					</a>
					<div class="hero-card__links">
						<a href={url('/contact/#message')} data-contact>
							<Icon name="message" size={20} />
							Send us a message
						</a>
					</div>
				</div>

				<!-- Static OpenStreetMap image. One link to Google Maps directions. -->
				<div class="hero-map">
					<a
						class="hero-map__link"
						href={clinic.directions}
						target="_blank"
						rel="noopener"
						aria-label="Get directions to Bass Coast Podiatry on Google Maps">
						<img
							class="hero-map__img"
							src={url('/images/hero-map@2x.webp')}
							alt=""
							width="900"
							height="720"
							decoding="async"
						/>
						<span class="hero-map__pill" aria-hidden="true">
							<Icon name="pin" size={16} />
							Get directions
						</span>
					</a>
					<span class="hero-map__credit">© OpenStreetMap <span>contributors</span></span>
				</div>
				<a class="hero-card__claims on-blue" href={url('/claims-rebates/')}>
					<span><strong>Claims and rebates:</strong> Medicare, DVA, Tyro Health, TAC and WorkSafe</span>
					<span class="hero-card__arrow" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
				</a>
			</article>
		</div>

		<!-- Scroll cue: desktop only. Smoothly scrolls to Our services and fades out once the visitor scrolls. -->
		<a class="scroll-cue" href="#services" data-scroll-cue>
			<span class="scroll-cue__mouse" aria-hidden="true"><span class="scroll-cue__wheel"></span></span>
			<span class="visually-hidden">Scroll down to Our services</span>
		</a>
	</section>

	<section class="section services" id="services" aria-labelledby="services-title">
		<Glows set="section" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature plainNames />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="section" />
		<div class="container container--wide team__inner above-glow">
			<div class="frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="registration-note reveal">Our podiatrists are registered with the Podiatry Board of Australia through AHPRA.</p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic Tyro Health facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>


	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="section" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="section" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Scroll cue: smoothly scroll to Our services on click, and fade the cue out once the visitor scrolls.
	const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const updateCue = () => document.querySelector('[data-scroll-cue]')?.classList.toggle('is-hidden', window.scrollY > 24);

	document.addEventListener('astro:page-load', () => {
		const cue = document.querySelector<HTMLAnchorElement>('[data-scroll-cue]');
		if (!cue) return;
		updateCue();
		cue.addEventListener('click', (event) => {
			const target = document.getElementById('services');
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'start' });
		});
	});

	window.addEventListener('scroll', updateCue, { passive: true });
</script>

<style>
	/* Hero: fills the screen below the header over the faded beach photo. No glow blobs over the photo.
	   Left: the heading, a small caps line, a sentence and the Our services button, straight on the background with
	   a soft white glow behind the words. Right: one solid white card with the contact details, a static map panel
	   and a solid Ocean blue Claims and rebates band. Hover is the shared frame effect; the band and map draw in
	   with the frame. */

	.hero {
		--header-h: 4.75rem;
		position: relative;
		display: grid;
		align-items: center;
		min-height: calc(100svh - var(--header-h));
		/* The soft glow behind the text must not widen the page on phones */
		overflow-x: clip;
		padding-block: clamp(2rem, 6vh, 4rem) clamp(4rem, 12vh, 7rem);
	}

	/* Matches the header: full menu (taller header) from 1100px */
	@media (min-width: 68.75rem) {
		.hero {
			--header-h: 6rem;
		}
	}

	/* The photo with a 55% white veil, so the beach and footprints show clearly. The moving background is
	   hidden on the home page (see global.css), so no blobs drift over it. */
	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		overflow: hidden;
	}

	.hero__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 50%;
	}

	.hero__bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--bcp-white) 55%, transparent);
	}

	.hero__grid {
		display: grid;
		gap: var(--space-l) 5%;
		align-items: center;
	}

	@media (min-width: 64rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr) clamp(34rem, 46%, 42rem);
		}
	}

	/* Soft white glow behind the words only, so the photo is lighter right behind them. It fades out at the
	   edges, so it never reads as a box. */
	.hero__main {
		position: relative;
		isolation: isolate;
	}

	.hero__main::before {
		content: '';
		position: absolute;
		inset: -22% -14% -26% -18%;
		z-index: -1;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--bcp-white) 92%, transparent) 0%,
			color-mix(in srgb, var(--bcp-white) 84%, transparent) 55%,
			color-mix(in srgb, var(--bcp-white) 40%, transparent) 82%,
			transparent 100%
		);
		pointer-events: none;
	}

	.hero__title {
		max-width: 12ch;
		margin: 0 0 clamp(1rem, 2vw, 1.5rem);
		color: var(--bcp-deep);
		font-size: clamp(2.5rem, 1rem + 4.4vw, 5rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.hero__line {
		margin: 0 0 var(--space-s);
		color: var(--bcp-deep);
		font-size: 1rem;
		font-weight: var(--bcp-weight-heading);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.hero__lead {
		max-width: 32rem;
		margin: 0 0 var(--space-m);
		color: var(--bcp-deep);
		font-size: 1.25rem;
		line-height: 1.55;
	}

	@media (max-width: 30rem) {
		/* Too long for one line on phones, so it splits evenly into two */
		.hero__line {
			font-size: 0.875rem;
			letter-spacing: 0.06em;
			text-wrap: balance;
		}
	}

	/* Solid white card. Phones: details, then the map strip, then the band. 768px and up: details and map side by
	   side at the same height, with the band across the full width underneath. */
	.hero-card {
		--hero-card-pad: clamp(1.75rem, 3.4vw, 3.25rem);
		--frame-radius: var(--bcp-radius-large);
		--frame-bg: var(--bcp-white);
		--frame-border: var(--glass-border);
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'body' 'map' 'claims';
	}

	.hero-card__body {
		grid-area: body;
	}

	.hero-card__claims {
		grid-area: claims;
	}

	@media (min-width: 48rem) {
		.hero-card {
			max-width: 42rem;
			grid-template-columns: minmax(0, 1fr) clamp(11.5rem, 36%, 15rem);
			grid-template-areas: 'body map' 'claims claims';
		}
	}

	.hero-card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.75rem;
		padding: var(--hero-card-pad);
		font-size: 1.0625rem;
	}

	.hero-card__list {
		display: grid;
		gap: 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.hero-card__list li {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.hero-card__list .icon-circle {
		width: 3rem;
		height: 3rem;
	}

	.hero-card__list p {
		margin: 0;
		color: var(--bcp-ink);
		line-height: 1.4;
	}

	.hero-card__list strong,
	.hero-card__list span:not(.icon-circle) {
		display: block;
	}

	.hero-card__list strong {
		font-weight: var(--bcp-weight-heading);
	}

	.hero-card__links {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.hero-card__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: var(--bcp-weight-heading);
	}

	/* Footer band: solid Ocean blue across the full width of the card, bottom corners rounded. Its colour is
	   drawn on ::before, which draws in with the card's frame on hover. */
	.hero-card__claims {
		position: relative;
		z-index: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		padding: 1.25rem var(--hero-card-pad);
		color: var(--bcp-white);
		line-height: 1.4;
		text-decoration: none;
	}

	.hero-card__claims::before {
		content: '';
		position: absolute;
		inset: 0 var(--frame-inset) var(--frame-inset);
		z-index: -1;
		border-radius: 0 0 var(--frame-radius) var(--frame-radius);
		background: var(--bcp-blue);
	}

	.hero-card__claims strong {
		font-weight: var(--bcp-weight-heading);
	}

	.hero-card__claims:hover span:first-child {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.hero-card__claims:focus-visible {
		outline: 3px solid var(--bcp-white);
		outline-offset: -6px;
		border-radius: 0 0 var(--frame-radius) var(--frame-radius);
	}

	.hero-card__arrow {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--bcp-white) 55%, transparent);
		border-radius: 50%;
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.hero-card__claims:hover .hero-card__arrow,
	.hero-card__claims:focus-visible .hero-card__arrow {
		background: var(--bcp-white);
		color: var(--bcp-blue);
	}

	/* Static map panel. The image is 900 x 720 CSS pixels (saved at 2x) with the clinic pin's tip at its centre.
	   --fx and --fy place the pin's tip inside the panel, just above the centred pill. Phones: a 120px strip above
	   the band. 768px and up: the card's right column, as tall as the details, with the card's top right corner.
	   The clip follows the card's frame inset, so the panel draws in with the card on hover. */
	.hero-map {
		--fx: 50%;
		--fy: calc(50% - 1.1rem);
		grid-area: map;
		position: relative;
		height: 7.5rem;
		overflow: hidden;
		background: #f2efe9;
		clip-path: inset(0 var(--frame-inset));
	}

	@media (min-width: 48rem) {
		.hero-map {
			height: auto;
			min-height: 15rem;
			clip-path: inset(var(--frame-inset) var(--frame-inset) 0 0 round 0 var(--frame-radius) 0 0);
		}

		/* Two short lines in the narrow panel */
		.hero-map__credit span {
			display: block;
		}
	}

	.hero-map__link {
		position: absolute;
		inset: 0;
		display: block;
		color: var(--bcp-blue);
		text-decoration: none;
	}

	.hero-map__link:focus-visible {
		outline: 3px solid var(--bcp-blue);
		outline-offset: -6px;
	}

	.hero-map__img {
		position: absolute;
		left: calc(var(--fx) - 450px);
		top: calc(var(--fy) - 360px);
		width: 900px;
		max-width: none;
		height: 720px;
	}

	/* Centred in the panel both ways */
	.hero-map__pill {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		width: max-content;
		padding: 0.35rem 0.85rem;
		border-radius: var(--bcp-radius-button);
		background: var(--bcp-white);
		box-shadow: var(--shadow-lift);
		font-size: 0.875rem;
		font-weight: var(--bcp-weight-heading);
		line-height: 1.3;
		white-space: nowrap;
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.hero-map__pill :global(svg) {
		flex: none;
	}

	.hero-map__link:hover .hero-map__pill,
	.hero-map__link:focus-visible .hero-map__pill {
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	/* Required OpenStreetMap credit, bottom right corner of the panel */
	.hero-map__credit {
		position: absolute;
		right: 0.4rem;
		bottom: 0.35rem;
		padding: 0.05rem 0.35rem;
		border-radius: 4px;
		background: color-mix(in srgb, var(--bcp-white) 88%, transparent);
		color: var(--bcp-ink);
		font-size: 0.6875rem;
		line-height: 1.35;
		text-align: right;
		pointer-events: none;
	}

	/* Scroll cue: a small mouse that gently bobs, centred near the bottom of the hero. Desktop only. */
	.scroll-cue {
		display: none;
	}

	@media (min-width: 64rem) {
		.scroll-cue {
			position: absolute;
			left: 50%;
			bottom: clamp(0.75rem, 3.5vh, 2.25rem);
			display: grid;
			place-items: center;
			width: 3rem;
			height: 3rem;
			translate: -50% 0;
			border-radius: 50%;
			color: var(--bcp-blue);
			transition: opacity 0.4s var(--ease), visibility 0.4s;
		}

		.scroll-cue.is-hidden {
			opacity: 0;
			visibility: hidden;
		}
	}

	.scroll-cue__mouse {
		position: relative;
		display: block;
		width: 1.5rem;
		height: 2.25rem;
		border: 2px solid currentColor;
		border-radius: 0.75rem;
	}

	.scroll-cue__wheel {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 3px;
		height: 0.45rem;
		translate: -50% 0;
		border-radius: 2px;
		background: currentColor;
	}

	.scroll-cue:hover {
		color: var(--bcp-deep);
	}

	@media (prefers-reduced-motion: no-preference) {
		.scroll-cue__mouse {
			animation: cue-bob 2.2s ease-in-out infinite;
		}
	}

	@keyframes cue-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	/* Hover and shadow come from the shared frame effect (.frame in global.css) */
	.team__image {
		aspect-ratio: 4 / 3;
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
