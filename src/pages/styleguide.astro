---
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import Icon from '../components/Icon.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/footprints-beach.jpg';
import brandCss from '../styles/brand.css?raw';
import tokensCss from '../styles/tokens.css?raw';
import { clinic, url } from '../data/site';

// Read the tokens straight from brand.css and tokens.css so this page always matches them.
const tokens = Object.fromEntries(
	[...(brandCss + tokensCss).matchAll(/--(bcp-[\w-]+):\s*([^;]+);/g)].map(([, name, value]) => [name, value.trim()]),
);

const colours = [
	{ token: 'bcp-cloud', name: 'Cloud grey', use: 'Base colour: the page background across the whole site, under the moving background.' },
	{ token: 'bcp-mint', name: 'Soft green', use: 'Moving background only, with Ocean blue, Sea cyan and a touch of Sand.' },
	{ token: 'bcp-white', name: 'White', use: 'Cards, glass and text on blue.' },
	{ token: 'bcp-mist', name: 'Mist', use: 'Base colour: quiet section backgrounds.' },
	{ token: 'bcp-blue', name: 'Ocean blue', use: 'Logo, headings, buttons, links and glows.' },
	{ token: 'bcp-deep', name: 'Deep Ocean blue', use: 'Contrast sections, the footer and the mobile menu, with white text.' },
	{ token: 'bcp-sea', name: 'Sea cyan', use: 'Glows, soft tints behind icons and focus rings. Never for text.' },
	{ token: 'bcp-ink', name: 'Ink', use: 'Body text.' },
	{ token: 'bcp-grey', name: 'Grey', use: 'Secondary text, such as intros and labels.' },
	{ token: 'bcp-sand', name: 'Sand', use: 'The logo arch and one small accent: the current page marker in the menu.' },
	{ token: 'bcp-sand-light', name: 'Light sand', use: 'In the brand pack, but no longer used for backgrounds on the website.' },
];

const logos = [
	{ file: 'bcp-logo-horizontal-blue', label: 'Horizontal logo, blue', dark: false },
	{ file: 'bcp-logo-horizontal-white', label: 'Horizontal logo, white', dark: true },
	{ file: 'bcp-logo-stacked-blue', label: 'Stacked logo, blue', dark: false },
	{ file: 'bcp-logo-stacked-white', label: 'Stacked logo, white', dark: true },
	{ file: 'bcp-icon-blue', label: 'Icon, blue', dark: false },
	{ file: 'bcp-icon-white', label: 'Icon, white', dark: true },
];

const iconNames = [
	'general',
	'laser',
	'biomechanics',
	'children',
	'surgery',
	'orthotics',
	'diabetes',
	'footwear',
	'phone',
	'pin',
	'clock',
	'directions',
	'arrowUpRight',
	'message',
	'claims',
	'person',
	'photo',
] as const;

const typeScale = [
	{ tag: 'h1', label: 'Heading 1 (home hero: up to 100px, white)', spec: 'Lexend Medium, 38px on phones to 76px on desktop' },
	{ tag: 'display', label: 'Section heading', spec: 'Lexend Regular, 36 to 68px, reveals line by line' },
	{ tag: 'h2', label: 'Heading 2', spec: 'Lexend Medium, 28 to 40px' },
	{ tag: 'h3', label: 'Heading 3', spec: 'Lexend Medium, 22px' },
	{ tag: 'h4', label: 'Heading 4', spec: 'Lexend Medium, 19px' },
] as const;
---

<Layout title="Style guide" description="Brand style guide for the Bass Coast Podiatry website: logos, colours, type and components.">
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<h1 class="reveal-lines">Brand style guide</h1>
			<p>Everything on this page uses the same brand.css and tokens.css variables as the website.</p>
		</div>
	</section>

	<section class="section" aria-labelledby="logos-title">
		<div class="container">
			<h2 id="logos-title">Logos</h2>
			<p class="sg-intro">Use the blue logo on white or light backgrounds and the white logo on Ocean blue.</p>
			<ul class="grid grid--2 sg-logos" role="list">
				{
					logos.map((logo) => (
						<li class="card">
							<div class:list={['sg-logo', { 'sg-logo--dark': logo.dark }]}>
								<img src={url(`/${logo.file}.svg`)} alt={logo.label} loading="lazy" />
							</div>
							<h3>{logo.label}</h3>
							<p class="sg-downloads">
								<a href={url(`/${logo.file}.svg`)} download>
									Download SVG<span class="visually-hidden">: {logo.label}</span>
								</a>
								<a href={url(`/downloads/${logo.file}.png`)} download>
									Download PNG<span class="visually-hidden">: {logo.label}</span>
								</a>
							</p>
						</li>
					))
				}
				<li class="card">
					<div class="sg-logo">
						<img src={url('/bcp-favicon.svg')} alt="Favicon" width="96" height="96" loading="lazy" />
					</div>
					<h3>Favicon</h3>
					<p class="sg-downloads">
						<a href={url('/bcp-favicon.svg')} download>Download SVG<span class="visually-hidden">: favicon</span></a>
						<a href={url('/bcp-favicon-512.png')} download>Download PNG<span class="visually-hidden">: favicon</span></a>
					</p>
				</li>
				<li class="card">
					<div class="sg-logo">
						<Icon name="general" size={72} />
					</div>
					<h3>Brand sheet</h3>
					<p class="sg-downloads">
						<a href={url('/downloads/BCP-brand-sheet.pdf')} download>Download the brand sheet (PDF)</a>
					</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="section section--mist" aria-labelledby="colours-title">
		<div class="container">
			<h2 id="colours-title">Colours</h2>
			<ul class="grid grid--4 sg-colours" role="list">
				{
					colours.map((c) => (
						<li class="card">
							<span class="sg-swatch" style={`background: var(--${c.token})`} />
							<h3>{c.name}</h3>
							<p class="sg-code">
								{tokens[c.token]}
								<br />
								<code>var(--{c.token})</code>
							</p>
							<p>{c.use}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="type-title">
		<div class="container">
			<h2 id="type-title">Type</h2>
			<p class="sg-intro">
				Font: Lexend from Google Fonts. Medium ({tokens['bcp-weight-heading']}) for headings, Regular ({tokens['bcp-weight-text']}) for
				text.
			</p>
			<div class="sg-type">
				{
					typeScale.map((t) => (
						<div class="sg-type__row">
							<p class="sg-type__label">{t.label}: {t.spec}</p>
							<p class={`sg-${t.tag}`}>Podiatry care in Wonthaggi</p>
						</div>
					))
				}
				<div class="sg-type__row">
					<p class="sg-type__label">Body text: Lexend Regular, 18px, line height 1.7</p>
					<p>Bass Coast Podiatry opened in July 2007 and has been providing full time Podiatry care since.</p>
				</div>
				<div class="sg-type__row">
					<p class="sg-type__label">Small text: Lexend Regular, 16px. Only for notes and labels.</p>
					<p class="sg-small">Before and after hours appointments are available.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="buttons-title">
		<div class="container">
			<h2 id="buttons-title">Buttons and links</h2>
			<p class="sg-intro">
				Button corners: <code>var(--bcp-radius-button)</code> ({tokens['bcp-radius-button']}). Buttons carry a small arrow that moves on
				hover. Buttons with their own icon, such as Call, leave the arrow off (class <code>btn--icon</code>).
			</p>
			<div class="btn-row sg-block">
				<a class="btn btn--icon" href="#buttons-title"><Icon name="phone" /> Button with an icon</a>
				<a class="btn" href="#buttons-title">Primary button</a>
				<a class="btn btn--outline" href="#buttons-title">Outline button</a>
			</div>
			<div class="sg-on-blue on-blue btn-row sg-block">
				<a class="btn btn--white" href="#buttons-title">White button</a>
				<a class="btn btn--ghost-white" href="#buttons-title">Outline on blue</a>
			</div>
			<p><a href="#buttons-title">Text link</a></p>
			<p><a class="text-link" href="#buttons-title">Link with arrow <Icon name="arrow" size={18} /></a></p>
		</div>
	</section>

	<section class="section" aria-labelledby="glow-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<h2 id="glow-title">Glows and glass cards</h2>
			<p class="sg-intro sg-solid">
				The page base is Cloud grey. Bright, blurred Ocean blue and Sea cyan glows sit behind the hero and the Services section, with
				smaller, softer ones further down. They drift and slowly change shape, are CSS only (<code>Glows.astro</code>, sets
				<code>hero</code>, <code>centre</code> and <code>soft</code>) and stand still when reduce motion is on. Text never sits directly on a
				glow: it sits on glass, a solid card or the deep blue section. Glass cards are semi-transparent white with a backdrop blur, a soft
				white border and a soft shadow, so the glow behind tints them. Large corners: <code>var(--bcp-radius-large)</code>
				({tokens['bcp-radius-large']}), hero panel and its cards: <code>var(--bcp-radius-panel)</code> ({tokens['bcp-radius-panel']}).
			</p>
			<div class="grid grid--4 sg-block">
				<div class="card glass sg-card sg-card--tint">
					<span class="sg-corner" aria-hidden="true"><Icon name="arrowUpRight" size={20} /></span>
					<span class="icon-circle"><Icon name="general" size={34} /></span>
					<h3>Glass card</h3>
					<p>Frosted white, tinted by the glow behind. Class <code>glass</code>, with a round outlined icon button in the corner.</p>
				</div>
				<div class="card sg-card">
					<span class="icon-circle"><Icon name="clock" size={34} /></span>
					<h3>Solid card</h3>
					<p>White with a soft shadow. Class <code>card</code>.</p>
				</div>
				<div class="card sg-card sg-card--blue on-blue">
					<h3>Blue card</h3>
					<p>For calls to action, with white text.</p>
				</div>
				<div class="zoom-frame sg-zoom">
					<img src={url('/downloads/bcp-logo-stacked-blue.png')} alt="Stacked logo in a frame that zooms gently on hover" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue" aria-labelledby="deep-title">
		<div class="container container--wide">
			<h2 id="deep-title">Deep Ocean blue section</h2>
			<p class="sg-intro">One full width section per page at most, for contrast. White text and outline badges.</p>
			<ClaimsBadges />
		</div>
	</section>

	<section class="section" aria-labelledby="cards-title">
		<div class="container">
			<h2 id="cards-title">Badges, notes and accordion</h2>
			<div class="grid grid--2 sg-block">
				<div>
					<h3>Text badges</h3>
					<ClaimsBadges />
				</div>
				<div>
					<h3>Client note</h3>
					<p class="check">[CHECK WITH CLIENT] Used in the preview for anything the client needs to confirm.</p>
				</div>
			</div>
			<h3>Accordion</h3>
			<div class="accordion">
				<details open>
					<summary>Question goes here</summary>
					<div class="answer"><p>The answer sits below the question and opens and closes on click or with the keyboard.</p></div>
				</details>
				<details>
					<summary>A closed question</summary>
					<div class="answer"><p>Hidden until opened.</p></div>
				</details>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="icons-title">
		<div class="container container--wide">
			<h2 id="icons-title">Icons</h2>
			<p class="sg-intro">
				One set throughout: Lucide, at a 1.75 stroke, in soft Sea cyan tinted circles. Icons sit beside a text label and are hidden from
				screen readers.
			</p>
			<ul class="sg-icons" role="list">
				{
					iconNames.map((n) => (
						<li>
							<span class="icon-circle"><Icon name={n} size={30} /></span>
							<code>{n}</code>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="hero-title">
		<div class="container container--wide">
			<h2 id="hero-title">Home hero</h2>
			<p class="sg-intro sg-solid">
				Two columns. Left: the H1 on its own, large, with plenty of space. Right, sitting lower so it lines up with the middle and bottom
				of the headline: the intro and the Call button, then a small bento row with the frosted Visit us card (today's hours, address,
				Get directions, Send us a message), a small solid Ocean blue Claims and rebates card, and a rounded photo tile. Phones: headline,
				intro and button, then the cards stacked. Call appears once in the hero; the header keeps its own Call button.
			</p>
			<div class="sg-hero">
				<p class="sg-hero__title">Large headline on its own</p>
				<div class="sg-hero__side">
					<p>Intro paragraph, then the Call button.</p>
					<span class="btn btn--icon"><Icon name="phone" /> Call {clinic.phone}</span>
					<div class="sg-bento">
						<div class="sg-bento__visit glass">
							<p class="sg-bento__title">Visit us</p>
							<p>Open today, {clinic.openTime} to {clinic.closeTime}</p>
						</div>
						<div class="sg-bento__claims on-blue">
							<p class="sg-bento__title">Claims and rebates</p>
							<p>Medicare, DVA, HICAPS, TAC and WorkSafe</p>
						</div>
						<div class="sg-bento__photo zoom-frame">
							<Image src={heroImage} alt="Footprints in the sand along the water's edge at a beach." widths={[400, 700]} sizes="20vw" />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="ambient-title">
		<div class="container container--wide">
			<h2 id="ambient-title">Moving background</h2>
			<p class="sg-intro sg-solid">
				A soft moving gradient is fixed behind every page (<code>Ambient.astro</code>): large blobs of Ocean blue, Sea cyan, Soft green
				and a touch of Sand drift, merge and change shape like a lava lamp, one cycle about 26 seconds. Content scrolls over it and glass
				cards pick up its colour. It is CSS only and animates <code>transform</code> alone, so it runs on the GPU without repainting. It
				pauses while the tab is hidden and stands still with reduce motion. Ocean blue is kept the palest, so Ink body text and Ocean blue
				headings keep strong contrast. Text still sits on cards or solid backgrounds wherever possible.
			</p>
			<ul class="sg-blobs" role="list">
				<li><span style="background: var(--bcp-blue); opacity: 0.4"></span>Ocean blue, 26% strength</li>
				<li><span style="background: var(--bcp-sea)"></span>Sea cyan, 75%</li>
				<li><span style="background: var(--bcp-mint)"></span>Soft green, 60%</li>
				<li><span style="background: var(--bcp-sand)"></span>Sand, 35%</li>
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="panel-title">
		<div class="container container--wide">
			<h2 id="panel-title">Contact panel</h2>
			<p class="sg-intro">
				Any link with <code>data-contact</code> opens the full screen contact panel: an Ocean blue circle grows from the link and fills
				the screen in about 700ms, then the form, phone, hours, address and map fade in. It closes with the X button, Escape or the back
				button, keeps focus inside while open and returns focus to the link. With reduce motion on, it simply fades in. Without
				JavaScript the link goes to the Contact page.
			</p>
			<a class="btn" href={url('/contact/#message')} data-contact>Try the contact panel</a>
		</div>
	</section>

	<section class="section section--mist" aria-labelledby="logo-row-title">
		<div class="container container--wide">
			<h2 id="logo-row-title">Logo row</h2>
			<p class="sg-intro">
				Partner and membership logos in one muted greyscale style, turning to colour on hover. Logos not yet cleared for use show as
				matching text tiles. The AHPRA logo is never used.
			</p>
			<LogoRow />
		</div>
	</section>

	<section class="section section--mist" aria-labelledby="forms-title">
		<div class="container">
			<h2 id="forms-title">Form fields</h2>
			<form class="card sg-form" action="#" onsubmit="return false">
				<div class="field">
					<label for="sg-name">Text field</label>
					<input class="input" id="sg-name" type="text" placeholder="Your name" />
				</div>
				<div class="field">
					<label for="sg-email">Field with a hint</label>
					<span class="hint" id="sg-email-hint">Hints sit between the label and the field.</span>
					<input class="input" id="sg-email" type="email" aria-describedby="sg-email-hint" />
				</div>
				<div class="field">
					<label for="sg-message">Text area</label>
					<textarea class="input" id="sg-message"></textarea>
				</div>
				<button class="btn" type="submit">Submit button</button>
			</form>
		</div>
	</section>
</Layout>

<style>
	.sg-intro {
		max-width: var(--width-text);
		margin-bottom: var(--space-l);
	}

	.sg-block {
		margin-bottom: var(--space-l);
	}

	.sg-logos,
	.sg-colours {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sg-logo {
		display: grid;
		place-items: center;
		height: 10rem;
		margin-bottom: var(--space-s);
		padding: var(--space-m);
		border-radius: calc(var(--bcp-radius) / 1.5);
		background: var(--bcp-mist);
		color: var(--bcp-blue);
	}

	.sg-logo--dark {
		background: var(--bcp-blue);
	}

	.sg-logo img {
		max-height: 100%;
		width: auto;
	}

	.sg-downloads {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
	}

	.sg-swatch {
		display: block;
		height: 6rem;
		margin-bottom: var(--space-s);
		border-radius: calc(var(--bcp-radius) / 1.5);
		border: var(--border);
	}

	.sg-code {
		font-weight: var(--bcp-weight-heading);
	}

	.sg-code code {
		font-weight: var(--bcp-weight-text);
		color: var(--bcp-grey);
		font-size: 1rem;
	}

	.sg-type__row {
		padding-block: var(--space-m);
		border-bottom: var(--border);
	}

	.sg-type__label {
		margin-bottom: var(--space-xs);
		color: var(--bcp-grey);
		font-size: 1rem;
	}

	.sg-icons {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
		gap: var(--space-m);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sg-icons li {
		display: grid;
		justify-items: center;
		gap: 0.5rem;
	}

	.sg-hero {
		display: grid;
		gap: var(--space-l);
		padding: var(--space-l);
		border-radius: var(--bcp-radius-large);
		background: color-mix(in srgb, var(--bcp-white) 35%, transparent);
	}

	@media (min-width: 64rem) {
		.sg-hero {
			grid-template-columns: 1.1fr 1fr;
		}

		.sg-hero__side {
			padding-top: 4rem;
		}
	}

	.sg-hero__title {
		margin: 0;
		color: var(--bcp-blue);
		font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
		font-weight: var(--bcp-weight-heading);
		line-height: 1.04;
		letter-spacing: -0.03em;
	}

	.sg-bento {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		grid-template-rows: auto auto;
		gap: 0.75rem;
		margin-top: var(--space-m);
	}

	.sg-bento p {
		margin: 0;
	}

	.sg-bento__visit {
		grid-row: span 2;
		padding: var(--space-s);
		border-radius: var(--bcp-radius-panel);
	}

	.sg-bento__claims {
		padding: var(--space-s);
		border-radius: var(--bcp-radius-panel);
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	.sg-bento__title {
		font-weight: var(--bcp-weight-heading);
	}

	.sg-bento__visit .sg-bento__title {
		color: var(--bcp-blue);
	}

	.sg-bento__photo {
		min-height: 6rem;
		border-radius: var(--bcp-radius-panel);
	}

	.sg-bento__photo img {
		height: 100%;
	}

	.sg-card--tint.glass {
		background: color-mix(in srgb, var(--bcp-white) 58%, transparent);
	}

	.sg-corner {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid color-mix(in srgb, var(--bcp-blue) 40%, transparent);
		border-radius: 50%;
		color: var(--bcp-blue);
	}

	.sg-blobs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-m);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sg-blobs li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem 0.5rem 0.5rem;
		border-radius: var(--bcp-radius-button);
		background: var(--bcp-white);
	}

	.sg-blobs span {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		filter: blur(3px);
	}

	.sg-display {
		margin: 0;
		color: var(--bcp-blue);
		font-size: clamp(2.25rem, 1.4rem + 3.8vw, 4.25rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
	}

	.sg-solid {
		padding: var(--space-m);
		border-radius: var(--bcp-radius);
		background: var(--bcp-white);
	}

	.sg-card .icon-circle {
		margin-bottom: var(--space-m);
	}

	.sg-card--blue {
		border: 0;
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	.sg-card--blue h3 {
		color: var(--bcp-white);
	}

	.sg-zoom {
		display: grid;
		place-items: center;
		min-height: 14rem;
		background: var(--bcp-white);
		box-shadow: var(--shadow);
	}

	.sg-zoom img {
		width: 60%;
		height: auto;
		object-fit: contain;
	}

	.sg-h1,
	.sg-h2,
	.sg-h3,
