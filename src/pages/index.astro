---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/podiatrist-treatment.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Podiatry in Wonthaggi since 2007. Bass Coast Podiatry is open Monday to Friday and no referral is needed. Call (03) 5672 2309.">
	<section class="hero">
		<div class="container container--wide hero__grid">
			<!-- Large photo card with the heading in its bottom left corner. The whole card links to Our services. -->
			<div class="hero-photo frame reveal">
				<Image
					class="hero-photo__img"
					src={heroImage}
					alt="A podiatrist in gloves treating a patient's toenail."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 62vw, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="hero-photo__text">
					<h1 class="hero-photo__title">Expert foot care in Wonthaggi</h1>
					<p class="hero-photo__line">No referral needed. Open five days a week.</p>
				</div>
				<a class="hero-photo__link" href={url('/our-services/')}><span class="visually-hidden">See our services</span></a>
			</div>

			<div class="hero__side">
				<article class="hcard frame reveal" aria-label="Visit us">
					<ul class="hcard__list" role="list">
						<li>
							<span class="icon-circle"><Icon name="clock" size={20} /></span>
							<p>
								<strong>{clinic.hours[0].days}</strong>
								<span>{clinic.hours[0].time}</span>
							</p>
						</li>
						<li>
							<span class="icon-circle"><Icon name="pin" size={20} /></span>
							<p>
								<span>{clinic.street},</span>
								<span>{clinic.suburb}</span>
							</p>
						</li>
					</ul>
					<a class="btn btn--icon hcard__call" href={clinic.phoneHref} data-hero-call>
						<Icon name="phone" />
						Call {clinic.phone}
					</a>
					<div class="hcard__links">
						<a href={url('/contact/#message')} data-contact>
							<Icon name="message" size={20} />
							Send us a message
						</a>
						<a href={clinic.directions} rel="noopener">
							<Icon name="pin" size={20} />
							Get directions
						</a>
					</div>
				</article>

				<article class="claims-card frame on-blue reveal" aria-labelledby="claims-card-title">
					<span class="claims-card__arrow" aria-hidden="true"><Icon name="arrowUpRight" size={20} /></span>
					<h2 id="claims-card-title">Claims and rebates</h2>
					<p>
						<a class="claims-card__stretch" href={url('/claims-rebates/')}>Medicare, DVA, HICAPS, TAC and WorkSafe</a>
					</p>
				</article>
			</div>
		</div>

		<!-- Scroll cue: desktop only. Smoothly scrolls to Our services and fades out once the visitor scrolls. -->
		<a class="scroll-cue" href="#services" data-scroll-cue>
			<span class="scroll-cue__mouse" aria-hidden="true"><span class="scroll-cue__wheel"></span></span>
			<span class="visually-hidden">Scroll down to Our services</span>
		</a>
	</section>

	<section class="section services" id="services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards plainNames />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="soft" />
		<div class="container container--wide team__inner above-glow">
			<div class="frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="soft" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Scroll cue: smoothly scroll to Our services on click, and fade the cue out once the visitor scrolls.
	const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const updateCue = () => document.querySelector('[data-scroll-cue]')?.classList.toggle('is-hidden', window.scrollY > 24);

	document.addEventListener('astro:page-load', () => {
		const cue = document.querySelector<HTMLAnchorElement>('[data-scroll-cue]');
		if (!cue) return;
		updateCue();
		cue.addEventListener('click', (event) => {
			const target = document.getElementById('services');
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'start' });
		});
	});

	window.addEventListener('scroll', updateCue, { passive: true });
</script>

<style>
	/* Hero: on desktop it fills exactly the screen below the header, so only the three bento cards show on load.
	   The bento group (photo card on the left, white Visit us card above the blue Claims card on the right) sits
	   in the middle, as tall as the two right cards' content and at most 1400px wide. Hover is the shared frame effect. */

	.hero {
		--header-h: 4.75rem;
		position: relative;
		padding-block: clamp(0.75rem, 2.5vh, 1.75rem) clamp(2rem, 5vh, 3.5rem);
	}

	.hero__grid {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@media (min-width: 64rem) {
		.hero {
			--header-h: 6rem;
			display: grid;
			place-items: center;
			height: calc(100svh - var(--header-h));
			min-height: 32rem;
			padding-block: 0;
		}

		.hero__grid {
			grid-template-columns: minmax(0, 1fr) clamp(17.5rem, 24%, 22rem);
			max-width: calc(87.5rem + var(--gutter) * 2);
			/* The two right cards set the group's height; the minimum stops it looking squashed on small laptops */
			min-height: 24rem;
		}
	}

	/* Photo card */
	.hero-photo {
		--frame-radius: var(--bcp-radius-panel);
		--frame-bg: var(--bcp-deep);
		display: flex;
		align-items: flex-end;
		min-height: 30rem;
	}

	@media (min-width: 64rem) {
		.hero-photo {
			min-height: 0;
		}
	}

	.hero-photo__img {
		position: absolute;
		inset: 0;
		z-index: -1;
		object-position: 60% 40%;
	}

	/* A gentle dark fade in the bottom left corner only, so the white text reads clearly. It draws in with the frame. */
	.hero-photo::after {
		content: '';
		position: absolute;
		inset: var(--frame-inset);
		z-index: -1;
		border-radius: var(--frame-radius);
		background: radial-gradient(
			120% 85% at 0% 100%,
			color-mix(in srgb, var(--bcp-deep) 82%, transparent) 0%,
			color-mix(in srgb, var(--bcp-deep) 55%, transparent) 38%,
			transparent 70%
		);
		pointer-events: none;
	}

	.hero-photo__text {
		padding: clamp(1.5rem, 3vw, 3rem);
		color: var(--bcp-white);
	}

	.hero-photo__title {
		max-width: 16ch;
		margin: 0 0 clamp(0.75rem, 1.6vh, 1.25rem);
		padding-bottom: 0.06em;
		color: var(--bcp-white);
		font-size: clamp(2rem, min(0.9rem + 4.2vw, 9vh), 5rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.hero-photo__line {
		margin: 0;
		color: var(--bcp-white);
		font-size: 1rem;
		font-weight: var(--bcp-weight-heading);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	@media (max-width: 30rem) {
		.hero-photo__line {
			font-size: 0.875rem;
			letter-spacing: 0.06em;
		}
	}

	/* The whole photo card links to Our services */
	.hero-photo__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--frame-radius);
	}

	.hero-photo__link:focus-visible {
		outline: none;
	}

	.hero-photo__link:focus-visible::after {
		outline: 3px solid var(--bcp-blue);
		outline-offset: 3px;
	}

	/* Right hand cards: together they match the photo card's height */
	.hero__side {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
		min-height: 0;
	}

	@media (min-width: 64rem) {
		.hero__side {
			grid-template-rows: 1fr auto;
		}
	}

	/* Visit us: a white card with a simple stacked list. On desktop the spacing and text follow the screen
	   height, so everything fits on short laptop screens. */
	.hcard {
		--frame-radius: var(--bcp-radius-panel);
		--frame-bg: var(--bcp-white);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 1.1rem;
		padding: 1.5rem;
		font-size: 1.0625rem;
	}

	@media (min-width: 64rem) {
		.hcard {
			gap: clamp(0.6rem, 1.8vh, 1.4rem);
			padding: 2rem;
			font-size: clamp(0.9375rem, 0.7rem + 0.55vh, 1.125rem);
		}
	}

	.hcard__list {
		display: grid;
		gap: clamp(0.6rem, 1.6vh, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.hcard__list li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.hcard__list .icon-circle {
		width: 2.75em;
		height: 2.75em;
	}

	.hcard__list p {
		margin: 0;
		line-height: 1.4;
	}

	.hcard__list strong,
	.hcard__list span:not(.icon-circle) {
		display: block;
	}

	.hcard__list strong {
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__call {
		min-height: 2.75rem;
		padding: 0.6rem 1.1rem;
		font-size: 1em;
	}

	.hcard__links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.hcard__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: var(--bcp-weight-heading);
	}

	/* Claims and rebates: smaller solid Ocean blue card with a round arrow button */
	.claims-card {
		--frame-radius: var(--bcp-radius-panel);
		--frame-bg: var(--bcp-blue);
		padding: clamp(1rem, 2.2vh, 1.6rem) 4.25rem clamp(1rem, 2.2vh, 1.6rem) clamp(1.1rem, 1.6vw, 1.6rem);
		color: var(--bcp-white);
	}

	.claims-card h2 {
		margin: 0 0 0.25rem;
		color: var(--bcp-white);
		font-size: clamp(1.125rem, 0.95rem + 0.4vw, 1.375rem);
		line-height: 1.3;
	}

	.claims-card p {
		margin: 0;
		line-height: 1.4;
	}

	.claims-card__arrow {
		position: absolute;
		top: clamp(0.9rem, 1.4vw, 1.25rem);
		right: clamp(0.9rem, 1.4vw, 1.25rem);
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid color-mix(in srgb, var(--bcp-white) 55%, transparent);
		border-radius: 50%;
		color: var(--bcp-white);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.claims-card:hover .claims-card__arrow,
	.claims-card:focus-within .claims-card__arrow {
		background: var(--bcp-white);
		color: var(--bcp-blue);
	}

	/* The whole Claims card is clickable through its link */
	.claims-card__stretch {
		color: var(--bcp-white);
		text-decoration: none;
	}

	.claims-card__stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--frame-radius);
	}

	.claims-card__stretch:focus-visible {
		outline: none;
	}

	.claims-card__stretch:focus-visible::after {
		outline: 3px solid var(--bcp-white);
		outline-offset: 3px;
	}

	/* Scroll cue: a small mouse that gently bobs, centred near the bottom of the hero. Desktop only. */
	.scroll-cue {
		display: none;
	}

	@media (min-width: 64rem) {
		.scroll-cue {
			position: absolute;
			left: 50%;
			bottom: clamp(0.75rem, 3.5vh, 2.25rem);
			display: grid;
			place-items: center;
			width: 3rem;
			height: 3rem;
			translate: -50% 0;
			border-radius: 50%;
			color: var(--bcp-blue);
			transition: opacity 0.4s var(--ease), visibility 0.4s;
		}

		.scroll-cue.is-hidden {
			opacity: 0;
			visibility: hidden;
		}
	}

	.scroll-cue__mouse {
		position: relative;
		display: block;
		width: 1.5rem;
		height: 2.25rem;
		border: 2px solid currentColor;
		border-radius: 0.75rem;
	}

	.scroll-cue__wheel {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 3px;
		height: 0.45rem;
		translate: -50% 0;
		border-radius: 2px;
		background: currentColor;
	}

	.scroll-cue:hover {
		color: var(--bcp-deep);
	}

	@media (prefers-reduced-motion: no-preference) {
		.scroll-cue__mouse {
			animation: cue-bob 2.2s ease-in-out infinite;
		}
	}

	@keyframes cue-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	/* Hover and shadow come from the shared frame effect (.frame in global.css) */
	.team__image {
		aspect-ratio: 4 / 3;
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
