---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Bass Coast Podiatry in Wonthaggi has provided podiatry care since 2007. Open Monday to Friday. Call (03) 5672 2309.">
	<section class="hero">
		<div class="container container--wide hero__grid">
			<!-- Large photo card, with the headline in its bottom left corner -->
			<div class="hero__photo zoom-frame">
				<Image
					src={heroImage}
					alt="Footprints in the sand along the water's edge at a beach."
					widths={[640, 1000, 1400, 1698]}
					sizes="(min-width: 64rem) 62vw, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="hero__copy">
					<h1 class="hero__title reveal-lines">Podiatry care in Wonthaggi since 2007</h1>
					<p class="hero__line">Open 5 days per week. Before and after hours appointments are available.</p>
					<a class="btn btn--icon" href={clinic.phoneHref} data-hero-call>
						<Icon name="phone" />
						Call {clinic.phone}
					</a>
				</div>
			</div>

			<div class="hero__cards">
				<!-- Visit us, over a faded map of the clinic location -->
				<article class="hcard hcard--visit glass" aria-labelledby="visit-card-title">
					<div class="hcard__map" aria-hidden="true">
						<iframe src={clinic.mapEmbed} title="Map of the clinic location" tabindex="-1" loading="eager"></iframe>
					</div>
					<a class="hcard__corner" href={clinic.directions} rel="noopener">
						<Icon name="directions" size={20} />
						<span class="visually-hidden">Get directions on Google Maps</span>
					</a>
					<h2 id="visit-card-title">Visit us</h2>
					<p class="hcard__today" data-today>{clinic.hours[0].days}, {clinic.hours[0].time}</p>
					<p class="hcard__note" data-today-note>{clinic.hoursNote}</p>
					<p class="hcard__address">
						{clinic.street}<br />
						{clinic.suburb}
					</p>
					<p class="hcard__phone"><a href={clinic.phoneHref}>{clinic.phone}</a></p>
					<p class="hcard__message"><a href={url('/contact/#message')} data-contact>Send us a message</a></p>
				</article>

				<!-- Claims and rebates, solid Ocean blue -->
				<article class="hcard hcard--claims on-blue" aria-labelledby="claims-card-title">
					<span class="hcard__corner" aria-hidden="true"><Icon name="arrowUpRight" size={20} /></span>
					<h2 id="claims-card-title">Claims and rebates</h2>
					<p><a class="hcard__stretch" href={url('/claims-rebates/')}>Medicare, DVA, HICAPS, TAC and WorkSafe</a></p>
				</article>
			</div>
		</div>
	</section>

	<section class="section services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal-lines">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature plainNames />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="soft" />
		<div class="container container--wide team__inner above-glow">
			<div class="zoom-frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal-lines">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this team list still current?</span></p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal-lines">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal-lines">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="soft" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal-lines">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Today's hours in the Visit us card, worked out in Wonthaggi's time zone.
	import { clinic } from '../data/site';

	function showToday() {
		const el = document.querySelector('[data-today]');
		if (!el) return;
		const day = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short' }).format(new Date());
		const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
		const open = (clinic.openDays as readonly number[]).includes(index);
		el.textContent = open ? `Open today, ${clinic.openTime} to ${clinic.closeTime}` : 'Closed today';
		const note = document.querySelector('[data-today-note]');
		if (note && !open) note.textContent = `Open ${clinic.hours[0].days}, ${clinic.hours[0].time}.`;
	}

	document.addEventListener('astro:page-load', showToday);
</script>

<style>
	/* Hero: the beach photo fills the screen width, with an Ocean blue glass veil deepest on the left */

	/* Hero, bento style: a large photo card on the left (about 65%) with the headline in its bottom left
	   corner, and two cards on the right (about 35%) at the same total height. About the height of the screen. */

	.hero {
		--header-h: 4.75rem;
		position: relative;
		display: grid;
		align-items: center;
		min-height: calc(100svh - var(--header-h));
		padding-block: clamp(1.25rem, 3vh, 2.5rem);
	}

	@media (min-width: 64rem) {
		.hero {
			--header-h: 6rem;
		}
	}

	.hero__grid {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@media (min-width: 64rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
		}
	}

	/* Photo card: clear and bright. A soft white gradient in the bottom left corner only keeps the text strong. */
	.hero__photo {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: 34rem;
		border-radius: var(--bcp-radius-panel);
		box-shadow: var(--shadow-lift);
	}

	@media (min-width: 64rem) {
		.hero__photo {
			min-height: 0;
			height: clamp(30rem, calc(100svh - var(--header-h) - 4rem), 46rem);
		}
	}

	.hero__photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 40%;
	}

	.hero__photo::after {
		content: '';
		position: absolute;
		inset: 0;
		/* Soft white rising from the bottom behind the text, strongest on the left. The upper part of the photo
		   (the walker and the footprints) stays clear and bright. */
		background:
			radial-gradient(ellipse 80% 70% at 0% 100%, color-mix(in srgb, var(--bcp-white) 70%, transparent) 0%, transparent 100%),
			linear-gradient(
				to top,
				color-mix(in srgb, var(--bcp-white) 95%, transparent) 0%,
				color-mix(in srgb, var(--bcp-white) 91%, transparent) 46%,
				color-mix(in srgb, var(--bcp-white) 45%, transparent) 60%,
				transparent 72%
			);
		pointer-events: none;
	}

	/* Phones: the text takes most of the card width, so the soft white rises from the bottom instead */
	@media (max-width: 63.99rem) {
		.hero__photo::after {
			background: linear-gradient(
				to top,
				color-mix(in srgb, var(--bcp-white) 96%, transparent) 0%,
				color-mix(in srgb, var(--bcp-white) 92%, transparent) 55%,
				color-mix(in srgb, var(--bcp-white) 55%, transparent) 75%,
				transparent 92%
			);
		}
	}

	.hero__copy {
		position: relative;
		z-index: 1;
		padding: clamp(1.5rem, 3vw, 2.75rem);
		max-width: 100%;
	}

	.hero__title {
		width: fit-content;
		max-width: 13em;
		margin: 0 0 0.6rem;
		font-size: clamp(2.25rem, 0.9rem + 3.7vw, 4.25rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
	}

	.hero__line {
		width: fit-content;
		max-width: 30rem;
		margin-bottom: var(--space-m);
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--bcp-ink);
	}

	/* Right hand cards: Visit us larger on top, Claims smaller below, together the height of the photo card */
	.hero__cards {
		display: grid;
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@media (min-width: 64rem) {
		.hero__cards {
			grid-template-rows: 1.7fr 1fr;
		}
	}

	.hcard {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: clamp(1.25rem, 1.8vw, 1.75rem);
		padding-right: 4.5rem;
		border-radius: var(--bcp-radius-panel);
		overflow: hidden;
		transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
	}

	.hcard h2 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.375rem, 1.1rem + 0.6vw, 1.75rem);
		line-height: 1.25;
	}

	.hcard p {
		margin: 0;
	}

	/* Frosted glass that the glow tints, turning solid white on hover */
	.hcard--visit.glass {
		background: color-mix(in srgb, var(--bcp-white) 66%, transparent);
	}

	.hcard--visit.glass:hover,
	.hcard--visit.glass:focus-within {
		background: var(--bcp-white);
		box-shadow: var(--shadow-lift);
	}

	/* Faded, non-interactive map of the clinic behind the Visit us text. It is drawn larger than the card
	   so the map's own buttons sit outside the visible area. */
	.hcard--visit {
		isolation: isolate;
	}

	.hcard__map {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0.22;
		filter: grayscale(1) contrast(0.85);
	}

	/* Drawn wider and taller than the card, centred on the clinic, so the map's own labels and buttons fall outside */
	.hcard__map iframe {
		position: absolute;
		top: -110px;
		left: -300px;
		width: calc(100% + 600px);
		max-width: none;
		height: calc(100% + 220px);
		border: 0;
		pointer-events: none;
	}

	.hcard__today {
		color: var(--bcp-blue);
		font-size: 1.25rem;
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__note {
		line-height: 1.45;
	}

	.hcard__address {
		margin-top: 0.75rem !important;
		line-height: 1.45;
	}

	.hcard__phone a {
		font-weight: var(--bcp-weight-heading);
	}

	.hcard__message {
		margin-top: auto !important;
		padding-top: 0.75rem;
	}

	.hcard__message a {
		font-size: 1.125rem;
	}

	/* Round outlined icon button in the top right corner */
	.hcard__corner {
		position: absolute;
		top: clamp(1rem, 1.5vw, 1.4rem);
		right: clamp(1rem, 1.5vw, 1.4rem);
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid color-mix(in srgb, var(--bcp-blue) 45%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--bcp-white) 70%, transparent);
		color: var(--bcp-blue);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	a.hcard__corner:hover {
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	/* Claims and rebates: solid Ocean blue */
	.hcard--claims {
		justify-content: center;
		background: var(--bcp-blue);
		color: var(--bcp-white);
		box-shadow: var(--shadow);
	}

	.hcard--claims h2 {
		color: var(--bcp-white);
	}

	.hcard--claims .hcard__corner {
		border-color: color-mix(in srgb, var(--bcp-white) 60%, transparent);
		background: transparent;
		color: var(--bcp-white);
	}

	.hcard--claims:hover .hcard__corner {
		background: var(--bcp-white);
		color: var(--bcp-blue);
	}

	/* The whole Claims card is clickable through its link */
	.hcard__stretch {
		color: var(--bcp-white);
		font-size: 1.125rem;
		line-height: 1.45;
		text-decoration: none;
	}

	.hcard__stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--bcp-radius-panel);
	}

	.hcard__stretch:focus-visible {
		outline: none;
	}

	.hcard__stretch:focus-visible::after {
		outline: 3px solid var(--bcp-white);
		outline-offset: -4px;
	}

	.hcard--claims:hover .hcard__stretch {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.team__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
