---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClaimsBadges from '../components/ClaimsBadges.astro';
import LogoRow from '../components/LogoRow.astro';
import VisitUs from '../components/VisitUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { clinic, url } from '../data/site';
import heroImage from '../assets/images/footprints-beach.jpg';
import teamImage from '../assets/images/diabetes-sensation-test.jpg';
---

<Layout description="Bass Coast Podiatry in Wonthaggi has provided podiatry care since 2007. Open Monday to Friday. Call (03) 5672 2309.">
	<section class="hero">
		<div class="container container--wide hero__grid">
			<div class="hero__main">
				<h1 class="hero__title reveal-lines">Podiatry care in Wonthaggi since 2007</h1>
				<div class="hero__intro reveal">
					<p class="hero__lead">
						Bass Coast Podiatry is open 5 days per week and is able to meet any special requirements of those needing urgent foot care.
					</p>
					<a class="btn btn--icon" href={clinic.phoneHref} data-hero-call>
						<Icon name="phone" />
						Call {clinic.phone}
					</a>
				</div>
			</div>

			<div class="hero__bento">
				<div class="bento bento--photo zoom-frame reveal">
					<Image
						src={heroImage}
						alt="Footprints in the sand along the water's edge at a beach."
						widths={[640, 1000, 1400]}
						sizes="(min-width: 64rem) 50vw, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
					<article class="bento bento--visit glass reveal" aria-labelledby="visit-card-title">
						<div class="bento__top">
							<span class="icon-circle"><Icon name="clock" size={24} /></span>
							<h2 id="visit-card-title">Visit us</h2>
						</div>
						<p class="bento__strong" data-today>{clinic.hours[0].days}, {clinic.hours[0].time}</p>
						<p class="bento__small" data-today-note>{clinic.hoursNote}</p>
						<p class="bento__address">
							{clinic.street}<br />
							{clinic.suburb}
						</p>
						<p class="bento__links">
							<a class="text-link" href={clinic.directions} rel="noopener">Get directions <Icon name="arrow" size={18} /></a>
							<a class="bento__message" href={url('/contact/#message')} data-contact>Send us a message</a>
						</p>
					</article>

					<article class="bento bento--claims on-blue reveal" aria-labelledby="claims-card-title">
						<span class="bento__corner" aria-hidden="true"><Icon name="arrowUpRight" size={18} /></span>
						<h2 id="claims-card-title">Claims and rebates</h2>
						<p>
							<a class="bento__stretch" href={url('/claims-rebates/')}>Medicare, DVA, HICAPS, TAC and WorkSafe</a>
						</p>
					</article>

			</div>
		</div>
	</section>

	<section class="section services" aria-labelledby="services-title">
		<Glows set="centre" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="services-title" class="display reveal-lines">Our services</h2>
				<p class="reveal">All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
			</div>
			<ServiceCards feature plainNames />
		</div>
	</section>

	<section class="section team" aria-labelledby="team-title">
		<Glows set="soft" />
		<div class="container container--wide team__inner above-glow">
			<div class="zoom-frame team__image reveal">
				<Image
					src={teamImage}
					alt="A podiatrist testing the sensation on the soles of a patient's feet."
					widths={[640, 1000, 1200]}
					sizes="(min-width: 64rem) 50vw, 100vw"
				/>
			</div>
			<div class="team__text">
				<h2 id="team-title" class="display reveal-lines">Meet the team</h2>
				<p class="team__lead reveal">
					Our podiatrists are Luke Zoanetti, Jennifer Lewis, Alison Kelly, Joshua Khoury and Angie Burgess. They are supported by our
					administration team, Kate, Brooke and Kim.
				</p>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this team list still current?</span></p>
				<a class="btn btn--outline reveal" href={url('/about-us/#team')}>Meet our team</a>
			</div>
		</div>
	</section>

	<section class="section section--deep on-blue claims" aria-labelledby="claims-title">
		<div class="container container--wide claims__inner">
			<div>
				<h2 id="claims-title" class="display reveal-lines">Claims and rebates</h2>
				<p class="claims__text reveal">
					Private health insurance rebates can be claimed on site through our electronic HICAPS facility. We also see patients through
					Medicare, the Department of Veterans Affairs, TAC and WorkSafe.
				</p>
			</div>
			<div class="reveal">
				<ClaimsBadges />
				<a class="text-link" href={url('/claims-rebates/')}>
					How claims and rebates work <Icon name="arrow" size={18} />
				</a>
			</div>
		</div>
	</section>

	<section class="section logos" aria-labelledby="logos-title">
		<div class="container container--wide reveal">
			<h2 id="logos-title" class="logos__title">Claims, rebates and memberships</h2>
			<LogoRow />
		</div>
	</section>

	<section class="section visit-section" aria-labelledby="visit-title">
		<Glows set="left" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="visit-title" class="display reveal-lines">Hours and location</h2>
			</div>
			<VisitUs />
		</div>
	</section>

	<section class="section faq" aria-labelledby="faq-title">
		<Glows set="soft" />
		<div class="container container--wide faq__inner above-glow">
			<div class="faq__head">
				<h2 id="faq-title" class="display reveal-lines">Frequently asked questions</h2>
				<a class="text-link reveal" href={url('/faqs/')}>
					See all FAQs <Icon name="arrow" size={18} />
				</a>
			</div>
			<div class="reveal">
				<FaqAccordion limit={3} />
			</div>
		</div>
	</section>
</Layout>

<script>
	// Today's hours in the Visit us card, worked out in Wonthaggi's time zone.
	import { clinic } from '../data/site';

	function showToday() {
		const el = document.querySelector('[data-today]');
		if (!el) return;
		const day = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short' }).format(new Date());
		const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
		const open = (clinic.openDays as readonly number[]).includes(index);
		el.textContent = open ? `Open today, ${clinic.openTime} to ${clinic.closeTime}` : 'Closed today';
		const note = document.querySelector('[data-today-note]');
		if (note && !open) note.textContent = `Open ${clinic.hours[0].days}, ${clinic.hours[0].time}.`;
	}

	document.addEventListener('astro:page-load', showToday);
</script>

<style>
	/* Hero: the beach photo fills the screen width, with an Ocean blue glass veil deepest on the left */

	/* Hero: left (about 45%) the headline, intro and Call button; right (about 55%) a bento block with the
	   photo across the top and the Visit us and Claims cards side by side below it. Both columns top-aligned. */

	.hero {
		position: relative;
		padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 7vh, 5rem);
	}

	.hero__grid {
		display: grid;
		gap: var(--space-l) clamp(2.5rem, 5vw, 5rem);
		align-items: start;
	}

	@media (min-width: 64rem) {
		.hero__grid {
			grid-template-columns: 45fr 55fr;
		}
	}

	/* About 15% smaller than before */
	.hero__title {
		margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
		font-size: clamp(2.25rem, 0.85rem + 4.25vw, 4.65rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
	}

	.hero__lead {
		max-width: 34rem;
		margin-bottom: var(--space-m);
		font-size: 1.25rem;
		line-height: 1.55;
		color: var(--bcp-ink);
	}

	/* Bento: the photo across the top, then Visit us and Claims side by side at matching heights */
	.hero__bento {
		display: grid;
		gap: clamp(0.75rem, 1.2vw, 1rem);
	}

	@media (min-width: 40rem) {
		.hero__bento {
			grid-template-columns: 1fr 1fr;
			align-items: stretch;
		}

		.bento--photo {
			grid-column: 1 / -1;
		}
	}

	.bento {
		position: relative;
		border-radius: var(--bcp-radius-panel);
	}

	.bento--visit,
	.bento--claims {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: clamp(1rem, 1.4vw, 1.35rem);
	}

	.bento--visit.glass {
		background: color-mix(in srgb, var(--bcp-white) 62%, transparent);
	}

	.bento__top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.4rem;
	}

	.bento .icon-circle {
		width: 2.75rem;
		height: 2.75rem;
	}

	.bento h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.bento p {
		margin: 0;
	}

	.bento__strong {
		color: var(--bcp-blue);
		font-weight: var(--bcp-weight-heading);
	}

	.bento__small,
	.bento__address {
		line-height: 1.45;
	}

	.bento__address {
		margin-top: 0.4rem !important;
	}

	.bento__links {
		display: grid;
		justify-items: start;
		gap: 0.3rem;
		margin-top: auto !important;
		padding-top: 0.6rem;
	}

	.bento__links a {
		font-weight: var(--bcp-weight-heading);
	}

	/* Small solid Ocean blue card, the blue card style from the style guide */
	.bento--claims {
		padding-right: 3.5rem;
		background: var(--bcp-blue);
		color: var(--bcp-white);
		box-shadow: var(--shadow);
	}

	.bento--claims h2 {
		color: var(--bcp-white);
		font-size: 1.125rem;
	}

	.bento__corner {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--bcp-white) 55%, transparent);
		border-radius: 50%;
		color: var(--bcp-white);
		transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
	}

	.bento--claims:hover .bento__corner {
		background: var(--bcp-white);
		color: var(--bcp-blue);
	}

	/* The whole Claims card is clickable through its link */
	.bento__stretch {
		color: var(--bcp-white);
		text-decoration: none;
		line-height: 1.45;
	}

	.bento__stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--bcp-radius-panel);
	}

	.bento__stretch:focus-visible {
		outline: none;
	}

	.bento__stretch:focus-visible::after {
		outline: 3px solid var(--bcp-white);
		outline-offset: 3px;
	}

	.bento--claims:hover .bento__stretch {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Large rounded photo across the right column */
	.bento--photo {
		aspect-ratio: 16 / 9;
		box-shadow: var(--shadow-lift);
	}

	.bento--photo img {
		position: absolute;
		inset: 0;
	}

	/* Team: a large photo beside the text */

	.team__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: center;
	}

	@media (min-width: 56rem) {
		.team__inner {
			grid-template-columns: 1.1fr 1fr;
		}
	}

	.team__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	.team__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.team__text .btn {
		margin-top: var(--space-s);
	}

	/* Claims: full width deep blue */

	.claims__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: end;
	}

	@media (min-width: 56rem) {
		.claims__inner {
			grid-template-columns: 1.2fr 1fr;
		}
	}

	.claims__text {
		max-width: 36rem;
		margin: 0;
		font-size: 1.25rem;
		color: color-mix(in srgb, var(--bcp-white) 88%, transparent);
	}

	.logos {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.logos__title {
		font-size: 1.25rem;
		color: var(--bcp-grey);
		margin-bottom: var(--space-m);
	}

	/* FAQ: heading on the left, questions on the right */

	.faq__inner {
		display: grid;
		gap: var(--space-l) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.faq__inner {
			grid-template-columns: 1fr 1.4fr;
			align-items: start;
		}

		.faq__head {
			position: sticky;
			top: 7rem;
		}
	}

	.faq__head h2 {
		margin-bottom: var(--space-m);
	}

	.faq :global(.accordion) {
		max-width: none;
	}
</style>
