---
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import ServiceCards from '../components/ServiceCards.astro';
import BookBox from '../components/BookBox.astro';
import beachImage from '../assets/images/footprints-beach.jpg';
---

<Layout title="Our services" description="Podiatry services at Bass Coast Podiatry in Wonthaggi, from general foot care to nail surgery and orthotics.">
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<h1 class="reveal">Our Services</h1>
			<p>All aspects of the profession are covered and no referral is needed to attend the clinic.</p>
		</div>
	</section>

	<section class="section">
		<div class="container container--wide">
			<h2 class="visually-hidden">All services</h2>
			<ServiceCards feature featureImage={beachImage} featureImageAlt="A person walking barefoot along the beach, leaving footprints in the sand." />
			<div class="services-book">
				<BookBox />
			</div>
		</div>
	</section>
</Layout>

<style>
	.services-book {
		max-width: var(--width-text);
		margin-top: var(--space-xl);
	}
</style>
