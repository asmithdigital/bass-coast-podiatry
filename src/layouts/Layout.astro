---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PasswordGate from '../components/PasswordGate.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Ambient from '../components/Ambient.astro';
import Icon from '../components/Icon.astro';
import { clinic, url } from '../data/site';

interface Props {
	title?: string;
	description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${clinic.name}` : `${clinic.name} | Podiatry in Wonthaggi`;
---

<!doctype html>
<html lang="en-AU" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<!-- Preview build: keep it out of search engines. Remove before launch. -->
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0B4F7C" />
		<link rel="icon" type="image/svg+xml" href={url('/bcp-favicon.svg')} />
		<link rel="icon" type="image/png" sizes="32x32" href={url('/bcp-favicon-32.png')} />
		<link rel="apple-touch-icon" sizes="180x180" href={url('/bcp-favicon-180.png')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500&display=swap" rel="stylesheet" />
		<!-- Runs before the page paints, and again after each page swap: marks JS as available
		     and hides the page behind the preview password. -->
		<script is:inline>
			(function () {
				function prepareRoot() {
					var root = document.documentElement;
					root.classList.add('js');
					var host = location.hostname;
					var isLocal = host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host === '::1';
					var unlocked = false;
					try {
						unlocked = sessionStorage.getItem('bcp-preview') === 'ok';
					} catch (e) {}
					if (!isLocal && !unlocked) root.classList.add('locked');
				}
				prepareRoot();
				if (!window.__bcpRootReady) {
					window.__bcpRootReady = true;
					document.addEventListener('astro:after-swap', prepareRoot);
					// Pause the moving background while the tab is hidden
					var pause = function () {
						document.documentElement.classList.toggle('ambient-paused', document.hidden);
					};
					document.addEventListener('visibilitychange', pause);
					document.addEventListener('astro:after-swap', pause);
				}
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<Ambient />
		<PasswordGate />
		<a class="skip-link" href="#main">Skip to main content</a>
		<SiteHeader />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<SiteFooter />
		<a class="mobile-call" href={clinic.phoneHref}>
			<Icon name="phone" />
			Call {clinic.phone}
		</a>
		<ContactPanel />
		<div class="page-wash" id="page-wash" aria-hidden="true" transition:persist></div>

		<script>
			const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

			let observer: IntersectionObserver | undefined;

			// One shared reveal (see global.css): everything with .reveal fades in with a short lift as it comes into view.
			function initMotion() {
				observer?.disconnect();
				const items = [...document.querySelectorAll<HTMLElement>('.reveal')];
				if (reduceMotion() || !('IntersectionObserver' in window)) {
					items.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				observer = new IntersectionObserver(
					(entries) => {
						// Items that come into view together reveal one after another, 80ms apart
						let order = 0;
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const el = entry.target as HTMLElement;
							el.style.setProperty('--reveal-delay', `${order++ * 80}ms`);
							el.classList.add('is-visible');
							observer?.unobserve(el);
						});
					},
					{ rootMargin: '0px 0px -8% 0px' },
				);
				items.forEach((el) => observer?.observe(el));
			}

			document.addEventListener('astro:page-load', initMotion);

			// On phones the fixed Call bar stays out of the way while the hero's own Call button is on screen,
			// so Call never shows twice above the fold.
			let callWatcher: IntersectionObserver | undefined;
			document.addEventListener('astro:page-load', () => {
				callWatcher?.disconnect();
				const bar = document.querySelector('.mobile-call');
				const heroCall = document.querySelector('[data-hero-call]');
				bar?.classList.remove('is-tucked');
				if (!bar || !heroCall || !('IntersectionObserver' in window)) return;
				callWatcher = new IntersectionObserver(([entry]) => bar.classList.toggle('is-tucked', entry.isIntersecting));
				callWatcher.observe(heroCall);
			});

			// Page transition: a soft Ocean blue to sea cyan wash fills the screen, then the new page fades in.
			document.addEventListener('astro:before-preparation', (event) => {
				const wash = document.getElementById('page-wash');
				if (!wash || reduceMotion() || event.defaultPrevented) return;
				const load = event.loader;
				event.loader = async () => {
					wash.classList.add('is-on');
					await Promise.all([load(), wait(260)]);
				};
			});

			document.addEventListener('astro:after-swap', () => {
				const wash = document.getElementById('page-wash');
				requestAnimationFrame(() => wash?.classList.remove('is-on'));
			});
		</script>
	</body>
</html>

<style>
	main:focus {
		outline: none;
	}

	.page-wash {
		position: fixed;
		inset: 0;
		z-index: 200;
		pointer-events: none;
		opacity: 0;
		background:
			radial-gradient(circle at 80% 20%, var(--bcp-sea), transparent 60%),
			linear-gradient(125deg, var(--bcp-blue), color-mix(in srgb, var(--bcp-sea) 70%, var(--bcp-blue)));
		transition: opacity 0.32s var(--ease);
	}

	.page-wash:global(.is-on) {
		opacity: 1;
		transition-duration: 0.26s;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(.js) main {
			animation: page-in 0.4s var(--ease);
		}
	}

	@keyframes page-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.mobile-call {
		position: fixed;
		left: var(--gutter);
		right: var(--gutter);
		bottom: max(0.75rem, env(safe-area-inset-bottom));
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 3.5rem;
		border-radius: var(--bcp-radius-button);
		background: var(--bcp-blue);
		color: var(--bcp-white);
		font-weight: var(--bcp-weight-heading);
		text-decoration: none;
		box-shadow: 0 10px 28px color-mix(in srgb, var(--bcp-deep) 30%, transparent);
		transition: transform 0.35s var(--ease), visibility 0s;
	}

	.mobile-call:global(.is-tucked) {
		visibility: hidden;
		transform: translateY(calc(100% + 1.5rem));
		transition: transform 0.35s var(--ease), visibility 0s linear 0.35s;
	}

	@media (min-width: 48rem) {
		.mobile-call {
			display: none;
		}
	}
</style>
