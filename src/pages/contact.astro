---
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import VisitUs from '../components/VisitUs.astro';
import { clinic } from '../data/site';
---

<Layout title="Contact" description="Call Bass Coast Podiatry on (03) 5672 2309 or send us a message. 182 Graham Street, Wonthaggi.">
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<h1 class="reveal-lines">Contact</h1>
			<p>For all appointments, call us today on <a href={clinic.phoneHref}>{clinic.phone}</a>.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<VisitUs headingLevel="h2" />
		</div>
	</section>

	<section class="section section--mist" aria-labelledby="form-title">
		<div class="container contact-form">
			<h2 id="form-title">Send us a message</h2>
			<p>Fill in the form and our administration team will get back to you. For urgent foot care, please call us.</p>
			<p class="check">
				[CHECK WITH CLIENT] This form uses Formspree with a placeholder form ID ({clinic.formspreeId}), so it will not send yet. Which email
				address should messages go to?
			</p>
			<form class="card" data-astro-reload action={`https://formspree.io/f/${clinic.formspreeId}`} method="POST">
				<div class="field">
					<label for="name">Your name</label>
					<input class="input" id="name" name="name" type="text" autocomplete="name" required />
				</div>
				<div class="field">
					<label for="phone">Phone number</label>
					<input class="input" id="phone" name="phone" type="tel" autocomplete="tel" required />
				</div>
				<div class="field">
					<label for="email">Email address</label>
					<span class="hint" id="email-hint">Optional</span>
					<input class="input" id="email" name="email" type="email" autocomplete="email" aria-describedby="email-hint" />
				</div>
				<div class="field">
					<label for="message">Message</label>
					<span class="hint" id="message-hint">Let us know if you would like an appointment and what times suit you.</span>
					<textarea class="input" id="message" name="message" required aria-describedby="message-hint"></textarea>
				</div>
				<input type="hidden" name="_subject" value="Website message for Bass Coast Podiatry" />
				<button class="btn" type="submit">Send message</button>
			</form>
		</div>
	</section>
</Layout>

<style>
	.contact-form {
		max-width: calc(var(--width-text) + var(--gutter) * 2);
	}
</style>
