---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PasswordGate from '../components/PasswordGate.astro';
import Icon from '../components/Icon.astro';
import { clinic, url } from '../data/site';

interface Props {
	title?: string;
	description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${clinic.name}` : `${clinic.name} | Podiatry in Wonthaggi`;
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<!-- Preview build: keep it out of search engines. Remove before launch. -->
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0B4F7C" />
		<link rel="icon" type="image/svg+xml" href={url('/bcp-favicon.svg')} />
		<link rel="icon" type="image/png" sizes="32x32" href={url('/bcp-favicon-32.png')} />
		<link rel="apple-touch-icon" sizes="180x180" href={url('/bcp-favicon-180.png')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500&display=swap" rel="stylesheet" />
		<!-- Runs before the page paints: marks JS as available and hides the page behind the preview password. -->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				var host = location.hostname;
				var isLocal = host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host === '::1';
				var unlocked = false;
				try {
					unlocked = sessionStorage.getItem('bcp-preview') === 'ok';
				} catch (e) {}
				if (!isLocal && !unlocked) root.classList.add('locked');
			})();
		</script>
	</head>
	<body>
		<PasswordGate />
		<a class="skip-link" href="#main">Skip to main content</a>
		<p class="preview-banner">Preview only. Not the live website.</p>
		<SiteHeader />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<SiteFooter />
		<a class="mobile-call" href={clinic.phoneHref}>
			<Icon name="phone" />
			Call {clinic.phone}
		</a>

		<script>
			// Fade sections in once as they scroll into view. Skipped when the visitor prefers reduced motion.
			const items = document.querySelectorAll('.reveal');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduce || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: '0px 0px -8% 0px' },
				);
				items.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>

<style>
	.preview-banner {
		margin: 0;
		padding: 0.4rem var(--gutter);
		background: var(--bcp-sand);
		color: var(--bcp-ink);
		font-size: 1rem;
		font-weight: var(--bcp-weight-heading);
		text-align: center;
	}

	main:focus {
		outline: none;
	}

	.mobile-call {
		position: fixed;
		left: var(--gutter);
		right: var(--gutter);
		bottom: max(0.75rem, env(safe-area-inset-bottom));
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 3.5rem;
		border-radius: var(--bcp-radius-button);
		background: var(--bcp-blue);
		color: var(--bcp-white);
		font-weight: var(--bcp-weight-heading);
		text-decoration: none;
		box-shadow: 0 6px 20px color-mix(in srgb, var(--bcp-ink) 25%, transparent);
	}

	@media (min-width: 48rem) {
		.mobile-call {
			display: none;
		}
	}
</style>
