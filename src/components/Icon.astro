---
// One icon set throughout: Lucide (ISC licence), all at the same stroke weight.
// Decorative by default, so screen readers skip them.
import {
	Activity,
	ArrowRight,
	Baby,
	Bandage,
	Clock,
	Droplet,
	Footprints,
	Image,
	Layers,
	MapPin,
	MessageSquare,
	Navigation,
	Phone,
	Receipt,
	Sparkles,
	SportShoe,
	User,
	X,
} from 'lucide-static';

const icons = {
	general: Footprints,
	laser: Sparkles,
	biomechanics: Activity,
	children: Baby,
	surgery: Bandage,
	orthotics: Layers,
	diabetes: Droplet,
	footwear: SportShoe,
	phone: Phone,
	pin: MapPin,
	clock: Clock,
	arrow: ArrowRight,
	directions: Navigation,
	message: MessageSquare,
	claims: Receipt,
	close: X,
	person: User,
	photo: Image,
};

interface Props {
	name: keyof typeof icons;
	size?: number;
}

const { name, size = 24 } = Astro.props;
// Keep only the shapes inside Lucide's <svg> so the wrapper below controls size and stroke.
const body = icons[name].replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class="icon"
	set:html={body}
/>
