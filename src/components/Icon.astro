---
// Simple line icons. Decorative by default, so screen readers skip them.
interface Props {
	name:
		| 'general'
		| 'laser'
		| 'biomechanics'
		| 'children'
		| 'surgery'
		| 'orthotics'
		| 'diabetes'
		| 'footwear'
		| 'phone'
		| 'pin'
		| 'clock'
		| 'arrow'
		| 'facebook';
	size?: number;
}

const { name, size = 24 } = Astro.props;

const footprint = {
	viewBox: '14 0 76 122',
	body: `<path d="M 80 31 C 72 23, 46 22, 32 36 C 18 50, 18 78, 34 100 C 40 110, 49 118, 54 114 C 58 110, 51 99, 51 86 C 50 70, 60 58, 72 52 C 84 46, 88 37, 80 31 Z"/><ellipse cx="70" cy="13.5" rx="9" ry="10.2"/><ellipse cx="53" cy="11.5" rx="6" ry="6.6"/><ellipse cx="40.5" cy="15.5" rx="5" ry="5.5"/><ellipse cx="30.5" cy="22.5" rx="4.3" ry="4.7"/><ellipse cx="23.5" cy="31.5" rx="3.7" ry="4"/>`,
};

const icons: Record<Props['name'], { viewBox: string; body: string }> = {
	general: footprint,
	laser: {
		viewBox: '0 0 24 24',
		body: '<path d="M7 22v-6.5a5 5 0 0 1 10 0V22"/><path d="M9.5 14.5h5v2.5a2.5 2.5 0 0 1-5 0z"/><path d="M12 2v4.5M4.5 4.5l2.8 2.8M19.5 4.5l-2.8 2.8"/>',
	},
	biomechanics: {
		viewBox: '0 0 24 24',
		body: '<ellipse cx="7.5" cy="16" rx="2.6" ry="4.2"/><circle cx="7.5" cy="9.3" r="1"/><ellipse cx="16.5" cy="9" rx="2.6" ry="4.2"/><circle cx="16.5" cy="2.3" r="1"/><path d="M14 21h7"/>',
	},
	children: {
		viewBox: '0 0 24 24',
		body: '<path d="M12 20.5s-7.5-4.6-7.5-10.4A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 2.5c0 5.8-7.5 10.4-7.5 10.4z"/>',
	},
	surgery: {
		viewBox: '0 0 24 24',
		body: '<rect x="1.8" y="8" width="20.4" height="8" rx="4" transform="rotate(-45 12 12)"/><rect x="9.6" y="9.6" width="4.8" height="4.8" transform="rotate(-45 12 12)"/>',
	},
	orthotics: {
		viewBox: '0 0 24 24',
		body: '<path d="M12 2.5c3.4 0 5.5 2.5 5.5 6 0 2.7-1.5 4.3-2 6.5-.5 2.3.5 3.5.5 4.9 0 1.5-1.7 2.6-4 2.6s-3.8-1-3.9-2.9c-.1-1.6.7-2.8.2-5C7.8 12.2 6.5 10.8 6.5 8.4c0-3.5 2.1-5.9 5.5-5.9z"/><path d="M10 7.5c.7 2.5.7 5-.6 7.5"/>',
	},
	diabetes: {
		viewBox: '0 0 24 24',
		body: '<path d="M12 2.8s6.5 6.6 6.5 11.4a6.5 6.5 0 0 1-13 0C5.5 9.4 12 2.8 12 2.8z"/><path d="M12 11v6M9 14h6"/>',
	},
	footwear: {
		viewBox: '0 0 24 24',
		body: '<path d="M2.5 18.5V8.8c0-.8.8-1.3 1.5-1l2.5 1.1c1.4.6 3 .5 4.3-.3l1-.6 2.7 3c.6.7 1.5 1.1 2.4 1.2l2.4.3c1.3.2 2.2 1.2 2.2 2.5v3.5z"/><path d="M2.5 15.5h19M9 10l1.2 1.6M11.5 9l1.2 1.6"/>',
	},
	phone: {
		viewBox: '0 0 24 24',
		body: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
	},
	pin: {
		viewBox: '0 0 24 24',
		body: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
	},
	clock: {
		viewBox: '0 0 24 24',
		body: '<circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2"/>',
	},
	arrow: {
		viewBox: '0 0 24 24',
		body: '<path d="M5 12h14M13 6l6 6-6 6"/>',
	},
	facebook: {
		viewBox: '0 0 24 24',
		body: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
	},
};

const icon = icons[name];
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox={icon.viewBox}
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class="icon"
	style={name === 'general' ? 'stroke-width: 6.5' : undefined}
	set:html={icon.body}
/>
