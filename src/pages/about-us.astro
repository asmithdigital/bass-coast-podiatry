---
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import { Image } from 'astro:assets';
import BookBox from '../components/BookBox.astro';
import Icon from '../components/Icon.astro';
import LogoRow from '../components/LogoRow.astro';
import aboutImage from '../assets/images/podiatrist-treatment.jpg';

const staff = [
	{
		name: 'Luke Zoanetti',
		role: 'Principal Podiatrist',
		bio: 'Luke was born and raised in the Bass Coast area. He enjoys all aspects of Podiatry and especially enjoys treating lower leg and foot problems in children, managing biomechanical complaints of the foot. Luke has worked as a casual lecturer for the Podiatry course at Charles Sturt University. Luke enjoys golf and cycling and is an avid downhill snow skier in the winter months.',
	},
	{
		name: 'Jennifer Lewis',
		role: 'Principal Podiatrist',
		bio: 'Jennifer has worked and lived in the Bass Coast region for the last 15 years. She is passionately committed to the Podiatry profession and enjoys all facets of Podiatry. Jennifer has developed a special interest in high risk and diabetes foot care and assessment. Jennifer enjoys dancing, walking her dog and is also an avid snow skier during the winter months.',
		check: '"The last 15 years" was written some years ago. Please confirm the number.',
	},
	{
		name: 'Alison Kelly',
		role: 'Podiatrist',
		bio: 'Alison graduated with a Bachelor of Podiatry from La Trobe University in 2009. She has since worked in both public and private Podiatry settings. Alison is highly skilled in diabetes foot care and assessment and biomechanical examination and treatment of the foot. Alison keeps very active outside of work and a highlight of this is completing the Oxfam Trailwalker in 2012, 2013 and 2014.',
	},
	{
		name: 'Joshua Khoury',
		role: 'Podiatrist',
		bio: 'Joshua joined Bass Coast Podiatry in 2020 with special interests in biomechanics and lower limb and foot injury treatment and prevention. Joshua enjoys the coastal lifestyle that Bass Coast offers.',
	},
	{
		name: 'Angie Burgess',
		role: 'Podiatrist',
		bio: 'Angie graduated with a Bachelor of Podiatry from Charles Sturt University in 2016. She enjoys all aspects of the Podiatry profession and has a keen interest in diabetic foot care and sports Podiatry. Angie loves all outdoor activities and regularly spends time freediving, camping and kayaking.',
	},
];
---

<Layout title="About us" description="Bass Coast Podiatry opened in Wonthaggi in July 2007. Meet our podiatrists and administration team.">
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<h1 class="reveal-lines">About Us</h1>
		</div>
	</section>

	<div class="container container--wide">
		<div class="zoom-frame about__image reveal">
			<Image
				src={aboutImage}
				alt="A podiatrist in gloves treating a patient's foot."
				widths={[640, 1000, 1200]}
				sizes="(min-width: 90rem) 90rem, 100vw"
				loading="eager"
			/>
		</div>
	</div>

	<section class="section" aria-labelledby="story-title">
		<div class="container container--wide story">
			<h2 id="story-title" class="display reveal-lines">Our clinic</h2>
			<div class="story__text reveal">
				<p class="story__lead">
					Bass Coast Podiatry opened in July 2007 and has been providing full time Podiatry care since. Bass Coast Podiatry is open 5 days
					per week and is able to meet any special requirements of those needing urgent foot care. All aspects of the profession are covered
					and no referral is needed to attend the clinic.
				</p>
				<p>
					Bass Coast Podiatry services the Department of Veterans Affairs, TAC, and WorkCover and provides on the spot rebates for patients
					referred from their GP under the EPC program.
				</p>
			</div>
		</div>
	</section>

	<section class="section section--mist team-section" id="team" aria-labelledby="team-title">
		<Glows set="right" />
		<div class="container container--wide above-glow">
			<div class="section-head">
				<h2 id="team-title" class="display reveal-lines">Meet our Staff</h2>
				<p class="reveal"><span class="check">[CHECK WITH CLIENT] Is this staff list still current? Staff photos are needed for the placeholders.</span></p>
			</div>
			<ul class="staff" role="list">
				{
					staff.map((person) => (
						<li class="staff__card glass reveal">
							<div class="placeholder staff__photo" role="img" aria-label={`Photo of ${person.name} to come`}>
								<Icon name="person" size={40} />
								<span class="placeholder__label">Photo to come</span>
							</div>
							<div class="staff__body">
								<h3>{person.name}</h3>
								<p class="staff__role">{person.role}</p>
								<p>{person.bio}</p>
								{person.check && <p class="check">[CHECK WITH CLIENT] {person.check}</p>}
							</div>
						</li>
					))
				}
				<li class="staff__card staff__card--admin reveal">
					<div class="staff__body">
						<h3>Our Administration team</h3>
						<p>Kate, Brooke and Kim.</p>
					</div>
				</li>
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="memberships-title">
		<div class="container container--wide">
			<h2 id="memberships-title" class="display reveal-lines">Claims, rebates and memberships</h2>
			<div class="reveal">
				<LogoRow />
			</div>
			<div class="about__book reveal">
				<BookBox />
			</div>
		</div>
	</section>
</Layout>

<style>
	.about__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	@media (min-width: 40rem) {
		.about__image {
			aspect-ratio: 21 / 9;
		}
	}

	.story {
		display: grid;
		gap: var(--space-m) var(--space-xl);
	}

	@media (min-width: 56rem) {
		.story {
			grid-template-columns: 1fr 1.5fr;
			align-items: start;
		}
	}

	.story__lead {
		font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
		line-height: 1.55;
	}

	.staff {
		display: grid;
		gap: clamp(1rem, 2vw, 1.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.staff {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 80rem) {
		.staff {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.staff__card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--bcp-radius-large);
		background: color-mix(in srgb, var(--bcp-white) 90%, transparent);
	}

	.staff__photo {
		aspect-ratio: 4 / 3;
		border-radius: 0;
	}

	.staff__body {
		padding: clamp(1.5rem, 2.5vw, 2rem);
	}

	.staff__body h3 {
		margin-bottom: 0.15rem;
	}

	.staff__role {
		display: inline-block;
		padding-bottom: var(--space-xs);
		border-bottom: 2px solid var(--bcp-sea);
		color: var(--bcp-grey);
	}

	.staff__card--admin {
		justify-content: center;
		background: var(--bcp-blue);
		color: var(--bcp-white);
	}

	.staff__card--admin h3 {
		color: var(--bcp-white);
	}

	.about__book {
		max-width: var(--width-text);
		margin-top: var(--space-xl);
	}
</style>
