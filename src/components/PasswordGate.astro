---
// Preview password screen. Only stops casual viewers: the password is in the page source.
// It is skipped on localhost (see the inline script in Layout.astro).
import { url } from '../data/site';
---

<div class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
	<form class="gate__box" id="gate-form">
		<img src={url('/bcp-logo-horizontal-blue.svg')} alt="Bass Coast Podiatry" width="240" height="88" />
		<p class="gate__title" id="gate-title">Website preview</p>
		<p>This preview is password protected. Please enter the password you were given.</p>
		<div class="field">
			<label for="gate-password">Password</label>
			<input class="input" id="gate-password" type="password" autocomplete="off" required aria-describedby="gate-error" />
			<p class="gate__error" id="gate-error" aria-live="polite"></p>
		</div>
		<button class="btn" type="submit">View preview</button>
	</form>
</div>

<script>
	const PASSWORD = 'bcp-preview';
	const root = document.documentElement;
	const form = document.getElementById('gate-form') as HTMLFormElement | null;
	const input = document.getElementById('gate-password') as HTMLInputElement | null;
	const error = document.getElementById('gate-error');

	if (root.classList.contains('locked')) input?.focus();

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (input?.value.trim() === PASSWORD) {
			try {
				sessionStorage.setItem('bcp-preview', 'ok');
			} catch {}
			root.classList.remove('locked');
			document.getElementById('main')?.focus();
		} else if (error) {
			error.textContent = 'That password is not right. Please try again.';
			input?.select();
		}
	});
</script>

<style is:global>
	.gate {
		display: none;
	}

	.locked body > :not(.gate) {
		display: none !important;
	}

	.locked .gate {
		display: grid;
		place-items: center;
		min-height: 100vh;
		padding: var(--gutter);
		background: var(--bcp-mist);
	}

	.gate__box {
		width: 100%;
		max-width: 26rem;
		padding: var(--space-l) var(--space-m);
		background: var(--bcp-white);
		border-radius: var(--bcp-radius);
		box-shadow: var(--shadow);
	}

	.gate__box img {
		width: 200px;
		height: auto;
		margin-bottom: var(--space-m);
	}

	.gate__title {
		color: var(--bcp-blue);
		font-size: 1.5rem;
		font-weight: var(--bcp-weight-heading);
		margin-bottom: var(--space-xs);
	}

	.gate__error {
		min-height: 1.5em;
		margin: 0;
		color: var(--bcp-ink);
		font-weight: var(--bcp-weight-heading);
		font-size: 1rem;
	}

	.locked body {
		padding-bottom: 0;
	}
</style>
