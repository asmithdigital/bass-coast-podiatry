---
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import BookBox from '../components/BookBox.astro';
---

<Layout title="FAQs" description="Answers to common questions about Bass Coast Podiatry, including referrals and rebates.">
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<h1 class="reveal">FAQs</h1>
		</div>
	</section>

	<section class="section">
		<div class="container container--wide page-grid">
			<div>
				<h2 class="visually-hidden">Questions and answers</h2>
				<FaqAccordion />
			</div>
			<div class="page-grid__aside">
				<BookBox />
			</div>
		</div>
	</section>
</Layout>

<style>

	.page-grid :global(.accordion) {
		max-width: none;
	}
</style>
