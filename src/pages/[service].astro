---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Glows from '../components/Glows.astro';
import BookBox from '../components/BookBox.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { url } from '../data/site';

export async function getStaticPaths() {
	const services = await getCollection('services');
	return services.map((service) => ({ params: { service: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<Layout title={service.data.title} description={service.data.summary}>
	<section class="page-hero">
		<Glows set="page" />
		<div class="container container--wide">
			<a class="eyebrow" href={url('/our-services/')}>Our services</a>
			<h1 class="reveal-lines">{service.data.title}</h1>
			<p>{service.data.summary}</p>
		</div>
	</section>

	{
		service.data.image && (
			<div class="container container--wide">
				<div class="zoom-frame service__image reveal">
					<Image
						src={service.data.image}
						alt={service.data.imageAlt ?? ''}
						widths={[640, 1000, 1400, 1700]}
						sizes="(min-width: 90rem) 90rem, 100vw"
					/>
				</div>
			</div>
		)
	}

	<section class="section service">
		<div class="container service__grid">
			<article class="prose">
				<Content />
			</article>
			<div class="service__aside">
				<BookBox />
			</div>
		</div>
	</section>

	<section class="section section--mist" aria-labelledby="other-title">
		<div class="container container--wide">
			<h2 id="other-title" class="display reveal-lines">Other services</h2>
			<ServiceCards exclude={service.id} />
		</div>
	</section>
</Layout>

<style>
	.service {
		padding-top: clamp(3rem, 6vw, 5rem);
	}

	.service__image {
		aspect-ratio: 4 / 3;
		box-shadow: var(--shadow-lift);
	}

	@media (min-width: 40rem) {
		.service__image {
			aspect-ratio: 21 / 9;
		}
	}

	.service__grid {
		display: grid;
		gap: var(--space-l) var(--space-xl);
		align-items: start;
	}

	@media (min-width: 64rem) {
		.service__grid {
			grid-template-columns: minmax(0, 1fr) 24rem;
		}

		.service__aside {
			position: sticky;
			top: 7rem;
		}
	}

	.section--mist h2 {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
</style>
